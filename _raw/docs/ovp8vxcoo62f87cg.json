\"u2e50fc5f\" id=\"u2e50fc5f\"><strong><span data-lake-id=\"u456b8b7c\" id=\"u456b8b7c\">Perplexity</span></strong><span data-lake-id=\"u62f20cc9\" id=\"u62f20cc9\">：语言模型内在评估，衡量概率分布预测能力 </span></li></ul><ol list=\"uf4a6d811\" start=\"2\"><li fid=\"u7afad483\" data-lake-id=\"u4b2ca624\" id=\"u4b2ca624\"><strong><span data-lake-id=\"uca186f1b\" id=\"uca186f1b\">项目选择原则</span></strong></li></ol><ul list=\"u0b94fd7d\" data-lake-indent=\"1\"><li fid=\"ubc53b046\" data-lake-id=\"ua147ca92\" id=\"ua147ca92\"><span data-lake-id=\"u3b9d3468\" id=\"u3b9d3468\">覆盖三大应用场景：机器翻译（BLEU）、摘要生成（ROUGE）、语言模型训练（Perplexity）</span></li><li fid=\"ubc53b046\" data-lake-id=\"u74e556c5\" id=\"u74e556c5\"><span data-lake-id=\"u3173fa89\" id=\"u3173fa89\">使用工业级案例：电商翻译系统、医疗报告生成、金融领域预训练</span></li></ul><ol list=\"uf4a6d811\" start=\"3\"><li fid=\"u7afad483\" data-lake-id=\"u86e44d0d\" id=\"u86e44d0d\"><strong><span data-lake-id=\"u9e495b2a\" id=\"u9e495b2a\">结构化逻辑</span></strong></li></ol><p data-lake-id=\"ud17853e9\" id=\"ud17853e9\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2025%2Fpng%2F2424104%2F1751690221741-d45d3196-99ff-4a92-b082-5ec6ee08e857.png%22%2C%22taskId%22%3A%22ub9fd04aa-6170-4aa6-b051-0600b4e764b%22%2C%22clientId%22%3A%22u42e21fa0-9816-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A610%2C%22height%22%3A498%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22ima-%E6%B5%81%E7%A8%8B%E5%9B%BE.png%22%2C%22size%22%3A212557%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A2874%2C%22originHeight%22%3A2346%2C%22ratio%22%3A1%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22ROUGE-%E7%94%9F%E6%88%90%E5%9C%BA%E6%99%AF%22%2C%22x%22%3A1238%2C%22y%22%3A1432%2C%22width%22%3A737%2C%22height%22%3A98%7D%2C%7B%22text%22%3A%22BLEU-%E7%BF%BB%E6%B3%BD%E5%9C%BA%E6%99%AF%22%2C%22x%22%3A127%2C%22y%22%3A1433%2C%22width%22%3A653%2C%22height%22%3A98%7D%2C%7B%22text%22%3A%22%E8%AF%84%E4%B