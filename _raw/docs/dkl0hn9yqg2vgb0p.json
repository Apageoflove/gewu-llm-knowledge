A%22plain%22%2C%22code%22%3A%22%23%20%E6%A2%AF%E5%BA%A6%E6%A3%80%E6%9F%A5%E7%82%B9%2B%E6%BF%80%E6%B4%BB%E5%80%BC%E5%8E%8B%E7%BC%A9%2BKV%E7%BC%93%E5%AD%98%E9%87%8F%E5%8C%96%5Cnmodel.enable_gradient_checkpointing()%5Cntorch.nn.Activations.set_compression(4)%20%23%204bit%E5%8E%8B%E7%BC%A9%5Cncache%20%3D%20KV_Cache(quant_bits%3D8%2C%20eviction_policy%3D%5C%22lru%5C%22)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22eG7EO%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u4a112692\" id=\"u4a112692\"><strong><span data-lake-id=\"ua7c05721\" id=\"ua7c05721\">3. 训练策略</span></strong><span data-lake-id=\"u4f593865\" id=\"u4f593865\">：</span></p><ul list=\"u7592ecf8\"><li fid=\"ud626a59d\" data-lake-id=\"ucd349be2\" id=\"ucd349be2\"><span data-lake-id=\"uedcdc454\" id=\"uedcdc454\">两阶段增量预训练： </span></li></ul><ul list=\"u7592ecf8\" data-lake-indent=\"1\"><li fid=\"uef03b4af\" data-lake-id=\"u4b2206d3\" id=\"u4b2206d3\"><span data-lake-id=\"ub13a7265\" id=\"ub13a7265\">阶段1：512→2048长度，余弦退火学习率</span></li><li fid=\"uef03b4af\" data-lake-id=\"uf1b6baff\" id=\"uf1b6baff\"><span data-lake-id=\"uf91cc319\" id=\"uf91cc319\">阶段2：2048→8192长度，引入位置插值</span></li></ul><ul list=\"u7592ecf8\" start=\"2\"><li fid=\"ud626a59d\" data-lake-id=\"u3b03a634\" id=\"u3b03a634\"><span data-lake-id=\"u9378d872\" id=\"u9378d872\">使用</span><strong><span data-lake-id=\"u8c46d869\" id=\"u8c46d869\">渐进式训练</span></strong><span data-lake-id=\"uac632482\" id=\"uac632482\">：batch_size随长度增加逐步减小</span></li></ul><p data-lake-id=\"u15061111\" id=\"u15061111\"><strong><span data-lake-id=\"u1391ae98\" id=\"u1391ae98\">效果验证</span></strong><span data-lake-id=\"uba3b3331\" id=\"uba3b3331\">：</span></p><ul list=\"u181f7881\"><li fid=\"u59a1150f\" data-lake-id=\"ub87df93b\" id=\"ub87df93b\"><span data-lake-id=\"u64b38f38\" id=\"u64b38f38\">在20K法律合同测试集上，准确率提升32%</span></li><li fid=\"u59a1150f\" data-lake-id=\"ue2cbe744\" id=\"ue2cbe744\"><span data-lake-id=\"u09a17e39\" id=\"u09a17e39\">P99延迟从8.7s降至1.2s</span></li><li fid=\"u59a1150f\" data-lake-id=\"u7cb91b3a\" id=\"u7cb91b3a\"><span data-lake-id=\"ua37ee358\" id=\"ua37ee358\">显存峰值下降41%</span></li></ul><card type=\"block\" name=\"hr\" value=\"data:%7B%22id%22%3A%22MensV%22%7D\"></card><h3 data-lake-id=\"2d325051\" id=\"2d325051\"><span data-lake-id=\"u5ae1e892\" id=\"u5ae1e892\">四、总结</span></h3><p data-lake-id=\"ua127f392\" id=\"ua127f392\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2025%2Fpng%2F2424104%2F1751687953990-ad57bd03-d14b-4c57-b4eb-da816daf7d36.png%22%2C%22taskId%22%3A%22uf73274c1-dc2f-449c-91de-2e8905c694d%22%2C%22clientId%22%3A%22u248c641c-fc70-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A392.53333333333336%2C%22height%22%3A160%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A34003%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A736%2C%22originHeight%22%3A300%2C%22ratio%22%3A1.875%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22%E7%AE%97%E6%B3%95%E5%88%9B%E6%96%B0%22%2C%22x%22%3A528%2C%22y%22%3A17%2C%22width%22%3A117%2C%22height%22%3A30%7D%2C%7B%22text%22%3A%22%E8%AE%AD%E7%BB%83%E6%8A%80%E5%B7%A7%22%2C%22x%22%3A525%2C%22y%22%3A103%2C%22width%22%3A127%2C%22height%22%3A31%7D%2C%7B%22text%22%3A%22%E6%95%88%E6%9E%9C%E8%AF%84%E4%BC%B0%22%2C%22x%22%3A528%2C%22y%22%3A240%2C%22width%22%3A117%2C%22height%22%3A30%7D%2C%7B%22text%22%3A%22%E4%BC%98%E5%8C%96%E6%A0%B8%E5%BF%83%22%2C%22x%22%3A250%2C%22y%22%3A59%2C%22width%22%3A114%2C%22height%22%3A30%7D%2C%7B%22text%22%3A%22%E6%8A%80%E6%9C%AF%E7%BB%84%E5%90%88%22%2C%22x%22%3A527%2C%22y%