s=\"lake-fontsize-12\" style=\"color: var(--ifm-table-cell-color)\">When a retriever ends</span></p></td><td data-lake-id=\"u4f3f6320\" id=\"u4f3f6320\"><p data-lake-id=\"ufc734b86\" id=\"ufc734b86\"><code data-lake-id=\"uc36d5d30\" id=\"uc36d5d30\"><span data-lake-id=\"uc7c60a28\" id=\"uc7c60a28\" class=\"lake-fontsize-12\" style=\"color: var(--ifm-table-cell-color)\">on_retriever_end</span></code></p></td></tr><tr data-lake-id=\"u571bc98f\" id=\"u571bc98f\"><td data-lake-id=\"u2c2fa174\" id=\"u2c2fa174\"><p data-lake-id=\"u8bbacdaf\" id=\"u8bbacdaf\"><span data-lake-id=\"u23d3abc6\" id=\"u23d3abc6\" class=\"lake-fontsize-12\" style=\"color: var(--ifm-table-cell-color)\">Retriever error</span></p></td><td data-lake-id=\"u791de007\" id=\"u791de007\"><p data-lake-id=\"u8d51ed9a\" id=\"u8d51ed9a\"><span data-lake-id=\"u9acf8223\" id=\"u9acf8223\" class=\"lake-fontsize-12\" style=\"color: var(--ifm-table-cell-color)\">When a retriever errors</span></p></td><td data-lake-id=\"u03f32d08\" id=\"u03f32d08\"><p data-lake-id=\"udfcc2576\" id=\"udfcc2576\"><code data-lake-id=\"u015b0c31\" id=\"u015b0c31\"><span data-lake-id=\"u0b854fb1\" id=\"u0b854fb1\" class=\"lake-fontsize-12\" style=\"color: var(--ifm-table-cell-color)\">on_retriever_error</span></code></p></td></tr><tr data-lake-id=\"ua5170216\" id=\"ua5170216\"><td data-lake-id=\"uafcca243\" id=\"uafcca243\"><p data-lake-id=\"u09fe1c7f\" id=\"u09fe1c7f\"><span data-lake-id=\"u69f0c3d2\" id=\"u69f0c3d2\" class=\"lake-fontsize-12\" style=\"color: var(--ifm-table-cell-color)\">Text</span></p></td><td data-lake-id=\"uc1e4fcf0\" id=\"uc1e4fcf0\"><p data-lake-id=\"u2d3879e5\" id=\"u2d3879e5\"><span data-lake-id=\"u184e0fb6\" id=\"u184e0fb6\" class=\"lake-fontsize-12\" style=\"color: var(--ifm-table-cell-color)\">When arbitrary text is run</span></p></td><td data-lake-id=\"u6420fc58\" id=\"u6420fc58\"><p data-lake-id=\"u417c2931\" id=\"u417c2931\"><code data-lake-id=\"u81b43986\" id=\"u81b43986\"><span data-lake-id=\"u3b5aa6c3\" id=\"u3b5aa6c3\" class=\"lake-fontsize-12\" style=\"color: var(--ifm-table-cell-color)\">on_text</span></code></p></td></tr><tr data-lake-id=\"u8c0d791f\" id=\"u8c0d791f\"><td data-lake-id=\"u99105fb3\" id=\"u99105fb3\"><p data-lake-id=\"u67c8b215\" id=\"u67c8b215\"><span data-lake-id=\"ub7df39d1\" id=\"ub7df39d1\" class=\"lake-fontsize-12\" style=\"color: var(--ifm-table-cell-color)\">Retry</span></p></td><td data-lake-id=\"ua4ba93c7\" id=\"ua4ba93c7\"><p data-lake-id=\"uc58c8ddc\" id=\"uc58c8ddc\"><span data-lake-id=\"u7d588558\" id=\"u7d588558\" class=\"lake-fontsize-12\" style=\"color: var(--ifm-table-cell-color)\">When a retry event is run</span></p></td><td data-lake-id=\"u7755f178\" id=\"u7755f178\"><p data-lake-id=\"u8db1f2d3\" id=\"u8db1f2d3\"><code data-lake-id=\"u9cfd11f1\" id=\"u9cfd11f1\"><span data-lake-id=\"ubfc356a7\" id=\"ubfc356a7\" class=\"lake-fontsize-12\" style=\"color: var(--ifm-table-cell-color)\">on_retry</span></code></p></td></tr></tbody></table><p data-lake-id=\"u37e2de9c\" id=\"u37e2de9c\"><br></p><h2 data-lake-id=\"sxlIi\" id=\"sxlIi\"><span data-lake-id=\"u76399690\" id=\"u76399690\" style=\"color: rgb(28, 30, 33)\">回调处理程序</span></h2><p data-lake-id=\"ucc68a708\" id=\"ucc68a708\"><code data-lake-id=\"u00b12e61\" id=\"u00b12e61\"><span data-lake-id=\"u3d2a78a2\" id=\"u3d2a78a2\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">CallbackHandlers</span></code><span data-lake-id=\"u2d445e57\" id=\"u2d445e57\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">是实现了</span><a href=\"https://api.python.langchain.com/en/latest/callbacks/langchain_core.callbacks.base.BaseCallbackHandler.html#langchain-core-callbacks-base-basecallbackhandler\" target=\"_blank\" data-lake-id=\"u9091e5f8\" id=\"u9091e5f8\"><span data-lake-id=\"ufacb8b43\" id=\"ufacb8b43\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">CallbackHandler</span></a><span data-lake-id=\"u1f417e62\" id=\"u1f417e62\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">接口的对象，该接口对应于可以订阅的每个事件都有一个方法。 当事件触发时，</span><code data-lake-id=\"u55498deb\" id=\"u55498deb\"><span data-lake-id=\"uad04cc9a\" id=\"uad04cc9a\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">CallbackManager</span></code><span data-lake-id=\"uf50001e9\" id=\"uf50001e9\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">将在每个处理程序上调用适当的方法。</span></p><p data-lake-id=\"ud7d31e09\" id=\"ud7d31e09\"><span data-lake-id=\"u14dc4f9b\" id=\"u14dc4f9b\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">参考：</span><a href=\"https://api.python.langchain.com/en/latest/callbacks/langchain_core.callbacks.base.BaseCallbackHandler.html#langchain-core-callbacks-base-basecallbackhandler\" target=\"_blank\" data-lake-id=\"u36729b7a\" id=\"u36729b7a\"><span data-lake-id=\"uf7f34799\" id=\"uf7f34799\" class=\"lake-fontsize-12\">https://api.python.langchain.com/en/latest/callbacks/langchain_core.callbacks.base.BaseCallbackHandler.html#langchain-core-callbacks-base-basecallbackhandler</span></a></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22%23%E7%A4%BA%E4%BE%8B%EF%BC%9Acallback_run.py%5Cnclass%20BaseCallbackHandler%3A%5Cn%20%20%20%20%5C%22%5C%22%5C%22%E5%8F%AF%E4%BB%A5%E7%94%A8%E6%9D%A5%E5%A4%84%E7%90%86langchain%E5%9B%9E%E8%B0%83%E7%9A%84%E5%9F%BA%E6%9C%AC%E5%9B%9E%E8%B0%83%E5%A4%84%E7%90%86%E7%A8%8B%E5%BA%8F%E3%80%82%5C%22%5C%22%5C%22%5Cn%20%20%20%20def%20on_llm_start(%5Cn%20%20%20%20%20%20%20%20self%2C%20serialized%3A%20Dict%5Bstr%2C%20Any%5D%2C%20prompts%3A%20List%5Bstr%5D%2C%20**kwargs%3A%20Any%5Cn%20%20%20%20)%20-%3E%20Any%3A%5Cn%20%20%20%20%20%20%20%20%5C%22%5C%22%5C%22LLM%E5%BC%80%E5%A7%8B%E8%BF%90%E8%A1%8C%E6%97%B6%E8%BF%90%E8%A1%8C%E3%80%82%5C%22%5C%22%5C%22%5Cn%20%20%20%20def%20on_chat_model_start(%5Cn%20%20%20%20%20%20%20%20self%2C%20serialized%3A%20Dict%5Bstr%2C%20Any%5D%2C%20messages%3A%20List%5BList%5BBaseMessage%5D%5D%2C%20**kwargs%3A%20Any%5Cn%20%20%20%20)%20-%3E%20Any%3A%5Cn%20%20%20%20%20%20%20%20%5C%22%5C%22%5C%22%E8%81%8A%E5%A4%A9%E6%A8%A1%E5%9E%8B%E5%BC%80%E5%A7%8B%E8%BF%90%E8%A1%8C%E6%97%B6%E8%BF%90%E8%A1%8C%E3%80%82%5C%22%5C%22%5C%22%5Cn%20%20%20%20%23%20%E5%85%B6%E4%BB%96%E6%96%B9%E6%B3%95%E7%9C%81%E7%95%A5...%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22QivmW%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"bOOpG\" id=\"bOOpG\"><span data-lake-id=\"ub5f51552\" id=\"ub5f51552\" style=\"color: rgb(28, 30, 33)\">传递回调函数</span></h2><p data-lake-id=\"ub80be64c\" id=\"ub80be64c\"><code data-lake-id=\"u43a0e41c\" id=\"u43a0e41c\"><span data-lake-id=\"u200eedc2\" id=\"u200eedc2\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">callbacks</span></code><span data-lake-id=\"udcbe3ba8\" id=\"udcbe3ba8\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\"> </span><span data-lake-id=\"ud6d3594a\" id=\"ud6d3594a\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">属性在 API 的大多数对象（模型、工具、代理等）中都可用，在两个不同的位置上：</span></p><ul list=\"u34e2f1f5\"><li fid=\"u6e9b13ab\" data-lake-id=\"u52c00107\" id=\"u52c00107\"><strong><span data-lake-id=\"u8d2c3f0e\" id=\"u8d2c3f0e\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">构造函数回调</span></strong><span data-lake-id=\"u10d7659f\" id=\"u10d7659f\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">：在构造函数中定义，例如 </span><code data-lake-id=\"u4e399629\" id=\"u4e399629\"><span data-lake-id=\"u4a4fd0ac\" id=\"u4a4fd0ac\" style=\"color: #080808; background-color: #ffffff\">ChatOpenAI</span><span data-lake-id=\"u26c1cb75\" id=\"u26c1cb75\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">(callbacks=[handler], tags=['a-tag'])</span></code><span data-lake-id=\"u93684488\" id=\"u93684488\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">。在这种情况下，回调函数将用于该对象上的所有调用，并且仅限于该对象。 例如，如果你使用构造函数回调初始化了一个聊天模型，然后在链式调用中使用它，那么回调函数只会在对该模型的调用中被调用。</span></li><li fid=\"u6e9b13ab\" data-lake-id=\"ufaa53d56\" id=\"ufaa53d56\"><strong><span data-lake-id=\"u4e95643a\" id=\"u4e95643a\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">请求回调</span></strong><span data-lake-id=\"ud1b08f8d\" id=\"ud1b08f8d\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">：传递给用于发出请求的 </span><code data-lake-id=\"uc5afa906\" id=\"uc5afa906\"><span data-lake-id=\"u30493f44\" id=\"u30493f44\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">invoke</span></code><span data-lake-id=\"u1c63e931\" id=\"u1c63e931\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\"> 方法。在这种情况下，回调函数仅用于该特定请求，以及它包含的所有子请求（例如，调用触发对模型的调用的序列的调用，该模型使用在 </span><code data-lake-id=\"u3512a7de\" id=\"u3512a7de\"><span data-lake-id=\"u8ea53081\" id=\"u8ea53081\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">invoke()</span></code><span data-lake-id=\"u6faa6a12\" id=\"u6faa6a12\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\"> 方法中传递的相同处理程序）。 在 </span><code data-lake-id=\"u6f8a3cb4\" id=\"u6f8a3cb4\"><span data-lake-id=\"u5a76b7e8\" id=\"u5a76b7e8\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">invoke()</span></code><span data-lake-id=\"uc678e67f\" id=\"uc678e67f\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\"> 方法中，通过 </span><code data-lake-id=\"ua6249cf3\" id=\"ua6249cf3\"><span data-lake-id=\"udf56dedf\" id=\"udf56dedf\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">config</span></code><span data-lake-id=\"u54331d2b\" id=\"u54331d2b\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\"> 参数传递回调函数。</span></li></ul><h2 data-lake-id=\"yJqtF\" id=\"yJqtF\"><span data-lake-id=\"u340e7f2f\" id=\"u340e7f2f\" style=\"color: rgb(28, 30, 33)\">在运行时传递回调函数</span></h2><p data-lake-id=\"u6d1bda7e\" id=\"u6d1bda7e\"><span data-lake-id=\"u6362c11a\" id=\"u6362c11a\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">许多情况下，当运行对象时，传递处理程序而不是回调函数会更有优势。当我们在执行运行时使用</span><span data-lake-id=\"ue952be57\" id=\"ue952be57\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\"> </span><code data-lake-id=\"u92a3210f\" id=\"u92a3210f\"><span data-lake-id=\"u847cee72\" id=\"u847cee72\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">callbacks</span></code><span data-lake-id=\"u0fc2e473\" id=\"u0fc2e473\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\"> </span><span data-lake-id=\"ua4b323dc\" id=\"ua4b323dc\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">关键字参数传递</span><span data-lake-id=\"uaaecb67c\" id=\"uaaecb67c\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\"> </span><a href=\"https://api.python.langchain.com/en/latest/callbacks/langchain_core.callbacks.base.BaseCallbackHandler.html#langchain-core-callbacks-base-basecallbackhandler\" target=\"_blank\" data-lake-id=\"ud16019ab\" id=\"ud16019ab\"><span data-lake-id=\"u08b29ead\" id=\"u08b29ead\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">CallbackHandlers</span></a><span data-lake-id=\"u208cdae1\" id=\"u208cdae1\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\"> </span><span data-lake-id=\"u18fe5420\" id=\"u18fe5420\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">时，这些回调函数将由执行中涉及的所有嵌套对象发出。例如，当通过一个处理程序传递给一个代理时，它将用于与代理相关的所有回调以及代理执行中涉及的所有对象，即工具和LLM。</span></p><p data-lake-id=\"ue86d835e\" id=\"ue86d835e\"><span data-lake-id=\"u18c784a2\" id=\"u18c784a2\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">这样可以避免我们手动将处理程序附加到每个单独的嵌套对象上。以下是一个示例：</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22%23%E7%A4%BA%E4%BE%8B%EF%BC%9Acallback_run.py%5Cn%23%20%E5%AF%BC%E5%85%A5%E6%89%80%E9%9C%80%E7%9A%84%E7%B1%BB%E5%9E%8B%E6%8F%90%E7%A4%BA%E5%92%8C%E7%B1%BB%5Cnfrom%20typing%20import%20Any%2C%20Dict%2C%20List%5Cnfrom%20langchain_core.callbacks%20import%20BaseCallbackHandler%5Cnfrom%20langchain_core.messages%20import%20BaseMessage%5Cnfrom%20langchain_core.outputs%20import%20LLMResult%5Cnfrom%20langchain_core.prompts%20import%20ChatPromptTemplate%5Cnfrom%20langchain_openai%20import%20ChatOpenAI%5Cn%5Cn%5Cn%23%20%E5%AE%9A%E4%B9%89%E4%B8%80%E4%B8%AA%E6%97%A5%E5%BF%97%E5%A4%84%E7%90%86%E5%99%A8%E7%B1%BB%EF%BC%8C%E7%BB%A7%E6%89%BF%E8%87%AABaseCallbackHandler%5Cnclass%20LoggingHandler(BaseCallbackHandler)%3A%5Cn%20%20%20%20%23%20%E5%BD%93%E8%81%8A%E5%A4%A9%E6%A8%A1%E5%9E%8B%E5%BC%80%E5%A7%8B%E6%97%B6%E8%B0%83%E7%94%A8%E7%9A%84%E6%96%B9%E6%B3%95%5Cn%20%20%20%20def%20on_chat_model_start(%5Cn%20%20%20%20%20%20%20%20%20%20%20%20self%2C%20serialized%3A%20Dict%5Bstr%2C%20Any%5D%2C%20messages%3A%20List%5BList%5BBaseMessage%5D%5D%2C%20**kwargs%5Cn%20%20%20%20)%20-%3E%20None%3A%5Cn%20%20%20%20%20%20%20%20print(%5C%22Chat%20model%20started%5C%22)%20%20%23%20%E6%89%93%E5%8D%B0%E2%80%9CChat%20model%20started%E2%80%9D%5Cn%5Cn%20%20%20%20%23%20%E5%BD%93LLM%E7%BB%93%E6%9D%9F%E6%97%B6%E8%B0%83%E7%94%A8%E7%9A%84%E6%96%B9%E6%B3%95%5Cn%20%20%20%20def%20on_llm_end(self%2C%20response%3A%20LLMResult%2C%20**kwargs)%20-%3E%20None%3A%5Cn%20%20%20%20%20%20%20%20print(f%5C%22Chat%20model%20ended%2C%20response%3A%20%7Bresponse%7D%5C%22)%20%20%23%20%E6%89%93%E5%8D%B0%E2%80%9CChat%20model%20ended%2C%20response%3A%20%7Bresponse%7D%E2%80%9D%5Cn%5Cn%20%20%20%20%23%20%E5%BD%93%E9%93%BE%E5%BC%80%E5%A7%8B%E6%97%B6%E8%B0%83%E7%94%A8%E7%9A%84%E6%96%B9%E6%B3%95%5Cn%20%20%20%20def%20on_chain_start(%5Cn%20%20%20%20%20%20%20%20%20%20%20%20self%2C%20serialized%3A%20Dict%5Bstr%2C%20Any%5D%2C%20inputs%3A%20Dict%5Bstr%2C%20Any%5D%2C%20**kwargs%5Cn%20%20%20%20)%20-%3E%20None%3A%5Cn%20%20%20%20%20%20%20%20print(f%5C%22Chain%20started%2C%20inputs%3A%7Binputs%7D%5C%22)%20%20%23%20%E6%89%93%E5%8D%B0%E2%80%9CChain%20%7Bserialized.get('name')%7D%20started%E2%80%9D%5Cn%5Cn%20%20%20%20%23%20%E5%BD%93%E9%93%BE%E7%BB%93%E6%9D%9F%E6%97%B6%E8%B0%83%E7%94%A8%E7%9A%84%E6%96%B9%E6%B3%95%5Cn%20%20%20%20def%20on_chain_end(self%2C%20outputs%3A%20Dict%5Bstr%2C%20Any%5D%2C%20**kwargs)%20-%3E%20None%3A%5Cn%20%20%20%20%20%20%20%20print(f%5C%22Chain%20ended%2C%20outputs%3A%20%7Boutputs%7D%5C%22)%20%20%23%20%E6%89%93%E5%8D%B0%E2%80%9CChain%20ended%2C%20outputs%3A%20%7Boutputs%7D%E2%80%9D%5Cn%5Cn%5Cn%23%20%E5%88%9B%E5%BB%BA%E4%B8%80%E4%B8%AA%E5%8C%85%E5%90%ABLoggingHandler%E5%AE%9E%E4%BE%8B%E7%9A%84%E5%9B%9E%E8%B0%83%E5%88%97%E8%A1%A8%5Cncallbacks%20%3D%20%5BLoggingHandler()%5D%5Cn%5Cn%23%20%E5%AE%9E%E4%BE%8B%E5%8C%96%E4%B8%80%E4%B8%AAChatOpenAI%E5%AF%B9%E8%B1%A1%EF%BC%8C%E4%BD%BF%E7%94%A8gpt-4%E6%A8%A1%E5%9E%8B%5Cnllm%20%3D%20ChatOpenAI(model%3D%5C%22gpt-4%5C%22)%5Cn%5Cn%23%20%E5%88%9B%E5%BB%BA%E4%B8%80%E4%B8%AA%E8%81%8A%E5%A4%A9%E6%8F%90%E7%A4%BA%E6%A8%A1%E6%9D%BF%EF%BC%8C%E6%A8%A1%E6%9D%BF%E5%86%85%E5%AE%B9%E4%B8%BA%E2%80%9CWhat%20is%201%20%2B%20%7Bnumber%7D%3F%E2%80%9D%5Cnprompt%20%3D%20ChatPromptTemplate.from_template(%5C%22What%20is%201%20%2B%20%7Bnumber%7D%3F%5C%22)%5Cn%5Cn%23%20%E5%B0%86%E6%8F%90%E7%A4%BA%E6%A8%A1%E6%9D%BF%E5%92%8CLLM%E7%BB%84%E5%90%88%E6%88%90%E4%B8%80%E4%B8%AA%E9%93%BE%5Cnchain%20%3D%20prompt%20%7C%20llm%5Cn%5Cn%23%20%E8%B0%83%E7%94%A8%E9%93%BE%E7%9A%84invoke%E6%96%B9%E6%B3%95%EF%BC%8C%E4%BC%A0%E5%85%A5%E5%8F%82%E6%95%B0number%E4%B8%BA%5C%222%5C%22%EF%BC%8C%E5%B9%B6%E9%85%8D%E7%BD%AE%E5%9B%9E%E8%B0%83%5Cnchain.invoke(%7B%5C%22number%5C%22%3A%20%5C%222%5C%22%7D%2C%20config%3D%7B%5C%22callbacks%5C%22%3A%20callbacks%7D)%5Cn%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22xAw0U%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u1b668ea0\" id=\"u1b668ea0\"><br></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22Chain%20started%2C%20inputs%3A%7B'number'%3A%20'2'%7D%5CnChain%20started%2C%20inputs%3A%7B'number'%3A%20'2'%7D%5CnChain%20ended%2C%20outputs%3A%20messages%3D%5BHumanMessage(content%3D'What%20is%201%20%2B%202%3F'%2C%20additional_kwargs%3D%7B%7D%2C%20response_metadata%3D%7B%7D)%5D%5CnChat%20model%20started%5CnChat%20model%20ended%2C%20response%3A%20generations%3D%5B%5BChatGeneration(text%3D'3'%2C%20generation_info%3D%7B'finish_reason'%3A%20'stop'%2C%20'logprobs'%3A%20None%7D%2C%20message%3DAIMessage(content%3D'3'%2C%20additional_kwargs%3D%7B'refusal'%3A%20None%7D%2C%20response_metadata%3D%7B'token_usage'%3A%20%7B'completion_tokens'%3A%201%2C%20'prompt_tokens'%3A%2015%2C%20'total_tokens'%3A%2016%2C%20'completion_tokens_details'%3A%20%7B'audio_tokens'%3A%20None%2C%20'reasoning_tokens'%3A%200%7D%2C%20'prompt_tokens_details'%3A%20%7B'audio_tokens'%3A%20None%2C%20'cached_tokens'%3A%200%7D%7D%2C%20'model_name'%3A%20'gpt-4-0613'%2C%20'system_fingerprint'%3A%20None%2C%20'finish_reason'%3A%20'stop'%2C%20'logprobs'%3A%20None%7D%2C%20id%3D'run-48925f3f-9bbf-4f13-8d48-b76757ffac32-0'%2C%20usage_metadata%3D%7B'input_tokens'%3A%2015%2C%20'output_tokens'%3A%201%2C%20'total_tokens'%3A%2016%2C%20'input_token_details'%3A%20%7B'cache_read'%3A%200%7D%2C%20'output_token_details'%3A%20%7B'reasoning'%3A%200%7D%7D))%5D%5D%20llm_output%3D%7B'token_usage'%3A%20%7B'completion_tokens'%3A%201%2C%20'prompt_tokens'%3A%2015%2C%20'total_tokens'%3A%2016%2C%20'completion_tokens_details'%3A%20%7B'audio_tokens'%3A%20None%2C%20'reasoning_tokens'%3A%200%7D%2C%20'prompt_tokens_details'%3A%20%7B'audio_tokens'%3A%20None%2C%20'cached_tokens'%3A%200%7D%7D%2C%20'model_name'%3A%20'gpt-4-0613'%2C%20'system_fingerprint'%3A%20None%7D%20run%3DNone%20type%3D'LLMResult'%5CnChain%20ended%2C%20outputs%3A%20content%3D'3'%20additional_kwargs%3D%7B'refusal'%3A%20None%7D%20response_metadata%3D%7B'token_usage'%3A%20%7B'completion_tokens'%3A%201%2C%20'prompt_tokens'%3A%2015%2C%20'total_tokens'%3A%2016%2C%20'completion_tokens_details'%3A%20%7B'audio_tokens'%3A%20None%2C%20'reasoning_tokens'%3A%200%7D%2C%20'prompt_tokens_details'%3A%20%7B'audio_tokens'%3A%20None%2C%20'cached_tokens'%3A%200%7D%7D%2C%20'model_name'%3A%20'gpt-4-0613'%2C%20'system_fingerprint'%3A%20None%2C%20'finish_reason'%3A%20'stop'%2C%20'logprobs'%3A%20None%7D%20id%3D'run-48925f3f-9bbf-4f13-8d48-b76757ffac32-0'%20usage_metadata%3D%7B'input_tokens'%3A%2015%2C%20'output_tokens'%3A%201%2C%20'total_tokens'%3A%2016%2C%20'input_token_details'%3A%20%7B'cache_read'%3A%200%7D%2C%20'output_token_details'%3A%20%7B'reasoning'%3A%200%7D%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22gYKcg%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"Qqysg\" id=\"Qqysg\"><span data-lake-id=\"u1576d0d3\" id=\"u1576d0d3\">自定义 callback handlers自定义 Chat model</span></h2><p data-lake-id=\"uc1adedbe\" id=\"uc1adedbe\"><span data-lake-id=\"ud474bd5b\" id=\"ud474bd5b\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">LangChain具有一些内置的回调处理程序，但通常您会希望创建具有自定义逻辑的自定义处理程序。</span></p><p data-lake-id=\"u56162d6e\" id=\"u56162d6e\"><span data-lake-id=\"u8a246b0b\" id=\"u8a246b0b\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">要创建自定义回调处理程序，我们需要确定我们希望处理的</span><a href=\"https://api.python.langchain.com/en/latest/callbacks/langchain_core.callbacks.base.BaseCallbackHandler.html#langchain-core-callbacks-base-basecallbackhandler\" target=\"_blank\" data-lake-id=\"u44af9a73\" id=\"u44af9a73\"><span data-lake-id=\"ud49c858b\" id=\"ud49c858b\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">event(s)</span></a><span data-lake-id=\"u06cdfaf4\" id=\"u06cdfaf4\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">，以及在触发事件时我们希望回调处理程序执行的操作。然后，我们只需将回调处理程序附加到对象上，例如通过</span><a href=\"http://www.aidoczh.com/langchain/v0.2/docs/how_to/callbacks_constructor/\" target=\"_blank\" data-lake-id=\"ud6a2621b\" id=\"ud6a2621b\"><span data-lake-id=\"u238d8702\" id=\"u238d8702\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">构造函数</span></a><span data-lake-id=\"u6df805b0\" id=\"u6df805b0\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">或</span><a href=\"http://www.aidoczh.com/langchain/v0.2/docs/how_to/callbacks_runtime/\" target=\"_blank\" data-lake-id=\"u5b11def0\" id=\"u5b11def0\"><span data-lake-id=\"udb58874c\" id=\"udb58874c\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">运行时</span></a><span data-lake-id=\"uf74a7d4a\" id=\"uf74a7d4a\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">。</span></p><p data-lake-id=\"u14c6c618\" id=\"u14c6c618\"><span data-lake-id=\"u0df91cff\" id=\"u0df91cff\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">在下面的示例中，我们将使用自定义处理程序实现流式处理。</span></p><p data-lake-id=\"ude1662ea\" id=\"ude1662ea\"><span data-lake-id=\"u7c480d54\" id=\"u7c480d54\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">在我们的自定义回调处理程序</span><code data-lake-id=\"ue2210e26\" id=\"ue2210e26\"><span data-lake-id=\"u81fe2686\" id=\"u81fe2686\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">MyCustomHandler</span></code><span data-lake-id=\"u4dbcc247\" id=\"u4dbcc247\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">中，我们实现了</span><code data-lake-id=\"u2870ca19\" id=\"u2870ca19\"><span data-lake-id=\"u8678c148\" id=\"u8678c148\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">on_llm_new_token</span></code><span data-lake-id=\"u3af18437\" id=\"u3af18437\" class=\"lake-fontsize-12\" style=\"color: rgb(28, 30, 33)\">处理程序，以打印我们刚收到的令牌。然后，我们将自定义处理程序作为构造函数回调附加到模型对象上。</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22%23%E7%A4%BA%E4%BE%8B%EF%BC%9Acallback_process.py%5Cnfrom%20langchain_openai%20import%20ChatOpenAI%5Cnfrom%20langchain_core.callbacks%20import%20BaseCallbackHandler%5Cnfrom%20langchain_core.prompts%20import%20ChatPromptTemplate%5Cn%5Cnclass%20MyCustomHandler(BaseCallbackHandler)%3A%5Cn%20%20%20%20def%20on_llm_new_token(self%2C%20token%3A%20str%2C%20**kwargs)%20-%3E%20None%3A%5Cn%20%20%20%20%20%20%20%20print(f%5C%22My%20custom%20handler%2C%20token%3A%20%7Btoken%7D%5C%22)%5Cn%5Cn%5Cnprompt%20%3D%20ChatPromptTemplate.from_messages(%5B%5C%22%E7%BB%99%E6%88%91%E8%AE%B2%E4%B8%AA%E5%85%B3%E4%BA%8E%7Banimal%7D%E7%9A%84%E7%AC%91%E8%AF%9D%EF%BC%8C%E9%99%90%E5%88%B620%E4%B8%AA%E5%AD%97%5C%22%5D)%5Cn%23%20%E4%B8%BA%E5%90%AF%E7%94%A8%E6%B5%81%E5%BC%8F%E5%A4%84%E7%90%86%EF%BC%8C%E6%88%91%E4%BB%AC%E5%9C%A8ChatModel%E6%9E%84%E9%80%A0%E5%87%BD%E6%95%B0%E4%B8%AD%E4%BC%A0%E5%85%A5%60streaming%3DTrue%60%5Cn%23%20%E5%8F%A6%E5%A4%96%EF%BC%8C%E6%88%91%E4%BB%AC%E5%B0%86%E8%87%AA%E5%AE%9A%E4%B9%89%E5%A4%84%E7%90%86%E7%A8%8B%E5%BA%8F%E4%BD%9C%E4%B8%BA%E5%9B%9E%E8%B0%83%E5%8F%82%E6%95%B0%E7%9A%84%E5%88%97%E8%A1%A8%E4%BC%A0%E5%85%A5%5Cnmodel%20%3D%20ChatOpenAI(%5Cn%20%20%20%20model%3D%5C%22gpt-4%5C%22%2C%20streaming%3DTrue%2C%20callbacks%3D%5BMyCustomHandler()%5D%5Cn)%5Cnchain%20%3D%20prompt%20%7C%20model%5Cnresponse%20%3D%20chain.invoke(%7B%5C%22animal%5C%22%3A%20%5C%22%E7%8C%AB%5C%22%7D)%5Cnprint(response.content)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22n