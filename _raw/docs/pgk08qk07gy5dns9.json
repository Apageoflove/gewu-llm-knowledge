%7B%22text%22%3A%221%22%2C%22x%22%3A953%2C%22y%22%3A308%2C%22width%22%3A28%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%223%22%2C%22x%22%3A713%2C%22y%22%3A263%2C%22width%22%3A27%2C%22height%22%3A36%7D%2C%7B%22text%22%3A%228%22%2C%22x%22%3A482%2C%22y%22%3A461%2C%22width%22%3A27%2C%22height%22%3A29%7D%2C%7B%22text%22%3A%224%22%2C%22x%22%3A708%2C%22y%22%3A350%2C%22width%22%3A37%2C%22height%22%3A25%7D%2C%7B%22text%22%3A%225%22%2C%22x%22%3A711%2C%22y%22%3A309%2C%22width%22%3A31%2C%22height%22%3A28%7D%2C%7B%22text%22%3A%225%22%2C%22x%22%3A480%2C%22y%22%3A349%2C%22width%22%3A30%2C%22height%22%3A26%7D%2C%7B%22text%22%3A%223%22%2C%22x%22%3A482%2C%22y%22%3A417%2C%22width%22%3A24%2C%22height%22%3A35%7D%2C%7B%22text%22%3A%226%22%2C%22x%22%3A949%2C%22y%22%3A386%2C%22width%22%3A33%2C%22height%22%3A26%7D%2C%7B%22text%22%3A%222%22%2C%22x%22%3A950%2C%22y%22%3A232%2C%22width%22%3A29%2C%22height%22%3A21%7D%2C%7B%22text%22%3A%227%22%2C%22x%22%3A948%2C%22y%22%3A419%2C%22width%22%3A35%2C%22height%22%3A32%7D%2C%7B%22text%22%3A%224%22%2C%22x%22%3A485%2C%22y%22%3A273%2C%22width%22%3A21%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%228%22%2C%22x%22%3A709%2C%22y%22%3A421%2C%22width%22%3A33%2C%22height%22%3A32%7D%2C%7B%22text%22%3A%227%22%2C%22x%22%3A704%2C%22y%22%3A458%2C%22width%22%3A40%2C%22height%22%3A32%7D%2C%7B%22text%22%3A%222%22%2C%22x%22%3A483%2C%22y%22%3A230%2C%22width%22%3A24%2C%22height%22%3A23%7D%2C%7B%22text%22%3A%227%22%2C%22x%22%3A484%2C%22y%22%3A307%2C%22width%22%3A24%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%226%22%2C%22x%22%3A480%2C%22y%22%3A385%2C%22width%22%3A31%2C%22height%22%3A27%7D%2C%7B%22text%22%3A%226%22%2C%22x%22%3A708%2C%22y%22%3A386%2C%22width%22%3A37%2C%22height%22%3A26%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23f8f7f5%22%2C%22id%22%3A%22ua634f0e3%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><p data-lake-id=\"ue14b74da\" id=\"ue14b74da\"><span data-lake-id=\"u1c52cd05\" id=\"u1c52cd05\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">QLoRA 是一种创新的微调 LLM 方法，经过多项任务验证，包括文本分类、问题回答和自然语言生成等，证明了其在各个领域的有效性。这一方法的出现为更广泛的用户和应用程序提供了更便捷的 LLM 应用方式，并有望进一步推动 LLM 在不同领域的应用。</span></p><p data-lake-id=\"u6ade57b8\" id=\"u6ade57b8\"><span data-lake-id=\"ub82ccc8d\" id=\"ub82ccc8d\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">接下来我们将介绍如何在单个 Google Colab 上微调最新的 Llama-2-7b 模型并将其转变为聊天机器人。我们将利用 Hugging Face 生态系统中的 PEFT 库以及 QLoRA 来实现更高效的内存微调。</span></p><p data-lake-id=\"ued68cfa5\" id=\"ued68cfa5\"><em><span data-lake-id=\"uff062ce1\" id=\"uff062ce1\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">​</span></em><br></p><p data-lake-id=\"u75d9447e\" id=\"u75d9447e\"><em><span data-lake-id=\"u195523d7\" id=\"u195523d7\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">​</span></em><span data-lake-id=\"u7ce20f7e\" id=\"u7ce20f7e\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">LoRA（低秩适配器）和 QLoRA（量化 LoRA）都是微调大型语言模型并减少内存需求的方法。然而，QLoRA 引入了多项创新，以在保持性能的同时进一步减少内存使用。以下是两种方法的比较：</span></p><p data-lake-id=\"u85ed354f\" id=\"u85ed354f\"><strong><span data-lake-id=\"udea3f832\" id=\"udea3f832\" style=\"color: rgb(51, 51, 51)\">LoRA：</span></strong></p><ul list=\"ufce8e5c7\"><li fid=\"uf9235fe3\" data-lake-id=\"ua0af60d3\" id=\"ua0af60d3\"><span data-lake-id=\"u8defe2d5\" id=\"u8defe2d5\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">- 使用一小组可训练参数（适配器），同时保持完整模型参数固定。</span></li><li fid=\"uf9235fe3\" data-lake-id=\"ua1f49289\" id=\"ua1f49289\"><span data-lake-id=\"u3efac53a\" id=\"u3efac53a\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">- 随机梯度下降期间的梯度通过固定的预训练模型权重传递到适配器，适配器被更新以优化损失函数。</span></li><li fid=\"uf9235fe3\" data-lake-id=\"ubde07891\" id=\"ubde07891\"><span data-lake-id=\"u6de5cb36\" id=\"u6de5cb36\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">- 与完全微调相比，内存效率更高，但仍需要 16 位精度进行训练。</span></li></ul><p data-lake-id=\"ue5901b2e\" id=\"ue5901b2e\"><strong><span data-lake-id=\"ued1bf359\" id=\"ued1bf359\" style=\"color: rgb(51, 51, 51)\">QLoRA：</span></strong></p><ul list=\"ue4e0d3ab\"><li fid=\"u7e767303\" data-lake-id=\"u442b524e\" id=\"u442b524e\"><span data-lake-id=\"ua5ff388b\" id=\"ua5ff388b\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">- 通过冻结的 4 位量化预训练语言模型将梯度反向传播到低阶适配器 (LoRA) 中。</span></li><li fid=\"u7e767303\" data-lake-id=\"u19c75640\" id=\"u19c75640\"><span data-lake-id=\"uf52463b6\" id=\"uf52463b6\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">- 引入 4 位 NormalFloat (NF4)，这是一种适用于正态分布数据的信息理论上最佳量化数据类型，可产生比 4 位整数和 4 位浮点更好的经验结果。</span></li><li fid=\"u7e767303\" data-lake-id=\"u9d7954fc\" id=\"u9d7954fc\"><span data-lake-id=\"ufa7fb8e6\" id=\"ufa7fb8e6\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">- 应用双量化，一种对量化常数进行量化的方法，每个参数平均节省约 0.37 位。</span></li><li fid=\"u7e767303\" data-lake-id=\"u7f18d483\" id=\"u7f18d483\"><span data-lake-id=\"u293a0c0a\" id=\"u293a0c0a\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">- 使用具有 NVIDIA 统一内存的分页优化器，以避免在处理具有长序列长度的小批量时在梯度检查点期间出现内存峰值。</span></li><li fid=\"u7e767303\" data-lake-id=\"uf2e504d9\" id=\"uf2e504d9\"><span data-lake-id=\"u51e8e42e\" id=\"u51e8e42e\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">- 显着降低内存需求，与 16 位完全微调基准相比，允许在单个 48GB GPU 上微调 65B 参数模型，而不会降低运行时间或预测性能。</span></li></ul><p data-lake-id=\"uddc4117b\" id=\"uddc4117b\"><span data-lake-id=\"u92f17d90\" id=\"u92f17d90\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">总之，QLoRA 建立在传统 LoRA 的基础上，引入了 4 位量化、4 位 NormalFloat 数据类型、双量化和分页优化器，以进一步减少内存使用，同时保持与 16 位微调方法相当的性能。</span></p><p data-lake-id=\"ub1755967\" id=\"ub1755967\"><br></p><h3 data-lake-id=\"qF0a7\" id=\"qF0a7\"><span data-lake-id=\"uced1c6da\" id=\"uced1c6da\">微调过程</span></h3><h4 data-lake-id=\"e9deffe1\" id=\"e9deffe1\"><span data-lake-id=\"u5e355718\" id=\"u5e355718\" style=\"color: rgb(51, 51, 51)\">1、PEFT 或参数高效微调</span></h4><p data-lake-id=\"uf5fb7aa7\" id=\"uf5fb7aa7\"><span data-lake-id=\"udb3d1560\" id=\"udb3d1560\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">PEFT（即参数高效微调）是 Hugging Face 的一个新开源库，可将预训练语言模型 (PLM) 高效地适应各种下游应用程序，而无需微调所有模型参数。 PEFT 目前包括以下技术：</span></p><ul list=\"u6083f79d\"><li fid=\"ud90c96a9\" data-lake-id=\"ua5b99f3c\" id=\"ua5b99f3c\"><span data-lake-id=\"ub5d91c67\" id=\"ub5d91c67\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">LoRA：大语言模型的低阶自适应 </span><em><span data-lake-id=\"u14e7478c\" id=\"u14e7478c\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">[8]</span></em></li><li fid=\"ud90c96a9\" data-lake-id=\"u1c2d92f9\" id=\"u1c2d92f9\"><span data-lake-id=\"uef040577\" id=\"uef040577\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">前缀调优：P-Tuning v2：快速调优可与跨尺度和任务的通用微调相媲美</span></li><li fid=\"ud90c96a9\" data-lake-id=\"uaf9ff5d2\" id=\"uaf9ff5d2\"><span data-lake-id=\"uf24b1f9b\" id=\"uf24b1f9b\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">P-Tuning：GPT 也能理解 </span><em><span data-lake-id=\"ucb22b28f\" id=\"ucb22b28f\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">[9]</span></em></li><li fid=\"ud90c96a9\" data-lake-id=\"uecab5cbf\" id=\"uecab5cbf\"><span data-lake-id=\"u3d7d4631\" id=\"u3d7d4631\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">即时调优：规模的力量可实现参数高效的即时调优 </span><em><span data-lake-id=\"u2ee99259\" id=\"u2ee99259\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">[10]</span></em></li></ul><h4 data-lake-id=\"9f3f1898\" id=\"9f3f1898\"><span data-lake-id=\"u288bc94a\" id=\"u288bc94a\" style=\"color: rgb(51, 51, 51)\">2、设置开发环境</span></h4><p data-lake-id=\"ue75d927a\" id=\"ue75d927a\"><span data-lake-id=\"uf6520587\" id=\"uf6520587\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">首先需要安装必要的依赖，我们将需要安装 </span><code data-lake-id=\"ue04b8423\" id=\"ue04b8423\"><span data-lake-id=\"u38f6b5bc\" id=\"u38f6b5bc\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">accelerate</span></code><span data-lake-id=\"u919c89a8\" id=\"u919c89a8\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\"> 、 </span><code data-lake-id=\"u9516c9d2\" id=\"u9516c9d2\"><span data-lake-id=\"u38a10469\" id=\"u38a10469\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">peft</span></code><span data-lake-id=\"u5da2cb8a\" id=\"u5da2cb8a\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\"> 、 </span><code data-lake-id=\"u020e3138\" id=\"u020e3138\"><span data-lake-id=\"uff01d3bd\" id=\"uff01d3bd\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">transformers</span></code><span data-lake-id=\"uaa076cc2\" id=\"uaa076cc2\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\"> 、 </span><code data-lake-id=\"u64f875f1\" id=\"u64f875f1\"><span data-lake-id=\"u00d796cf\" id=\"u00d796cf\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">datasets</span></code><span data-lake-id=\"u886a3a41\" id=\"u886a3a41\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\"> 和 TRL 库，以利用最新的 </span><code data-lake-id=\"u3a5fc260\" id=\"u3a5fc260\"><span data-lake-id=\"u8048ef4f\" id=\"u8048ef4f\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">SFTTrainer</span></code><span data-lake-id=\"u144b4b1d\" id=\"u144b4b1d\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\"> 。通过使用 </span><code data-lake-id=\"u056928a5\" id=\"u056928a5\"><span data-lake-id=\"u62ee0d80\" id=\"u62ee0d80\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">bitsandbytes</span></code><span data-lake-id=\"u35957be5\" id=\"u35957be5\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\"> 将基本模型量化为 4 位。同时还将安装 </span><code data-lake-id=\"u94369b3e\" id=\"u94369b3e\"><span data-lake-id=\"uf2ff0ee3\" id=\"uf2ff0ee3\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">einops</span></code><span data-lake-id=\"ub2a2923f\" id=\"ub2a2923f\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\"> ，因为它是加载 Falcon 模型所必须的库。</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22pip%20install%20trl%20transformers%20accelerate%20git%2Bhttps%3A%2F%2Fgithub.com%2Fhuggingface%2Fpeft.git%5Cnpip%20install%20datasets%20bitsandbytes%20einops%20wandb%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22HGHC7%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h4 data-lake-id=\"5e5e81a8\" id=\"5e5e81a8\"><span data-lake-id=\"u542a3c76\" id=\"u542a3c76\" style=\"color: rgb(51, 51, 51)\">3、准备数据集</span></h4><p data-lake-id=\"u27691294\" id=\"u27691294\"><span data-lake-id=\"u83b0fcfa\" id=\"u83b0fcfa\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">我们将从 AlexanderDoria/novel17_test 数据集中加载了 train 数据集分割。该数据集包含了一些法语小说的文本数据，用于进行自然语言处理任务的训练和评估。该数据集中的文本将被用于训练模型，以便让模型能够对法语小说进行自然语言处理。</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22from%20datasets%20import%20load_dataset%5Cn%20%5Cn%23dataset_name%20%3D%20%5C%22timdettmers%2Fopenassistant-guanaco%5C%22%20%23%23%23Human%20%2C.%2C%2C%2C%2C%2C%2C%20%23%23%23Assistant%5Cn%20%5Cndataset_name%20%3D%20'AlexanderDoria%2Fnovel17_test'%20%23french%20novels%5Cndataset%20%3D%20load_dataset(dataset_name%2C%20split%3D%5C%22train%5C%22)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22OwVpK%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h4 data-lake-id=\"01efb4c7\" id=\"01efb4c7\"><span data-lake-id=\"u6e481b51\" id=\"u6e481b51\" style=\"color: rgb(51, 51, 51)\">4、加载模型</span></h4><p data-lake-id=\"ue61ab4b4\" id=\"ue61ab4b4\"><span data-lake-id=\"u14b4364a\" id=\"u14b4364a\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">加载预训练模型并使用 BitsAndBytesConfig 函数设置了量化配置，将模型加载为 4 位，并使用 torch.float16 计算数据类型。通过 from_pretrained 函数将预训练模型加载到 model 变量中，并将量化配置传递给模型。</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22import%20torch%5Cnfrom%20transformers%20import%20AutoModelForCausalLM%2C%20AutoTokenizer%2C%20BitsAndBytesConfig%2C%20AutoTokenizer%5Cn%20%5Cnmodel_name%20%3D%20%5C%22TinyPixel%2FLlama-2-7B-bf16-sharded%5C%22%5Cn%20%5Cnbnb_config%20%3D%20BitsAndBytesConfig(%5Cn%20%20%20%20load_in_4bit%3DTrue%2C%5Cn%20%20%20%20bnb_4bit_quant_type%3D%5C%22nf4%5C%22%2C%5Cn%20%20%20%20bnb_4bit_compute_dtype%3Dtorch.float16%2C%5Cn)%5Cn%20%5Cnmodel%20%3D%20AutoModelForCausalLM.from_pretrained(%5Cn%20%20%20%20model_name%2C%5Cn%20%20%20%20quantization_config%3Dbnb_config%2C%5Cn%20%20%20%20trust_remote_code%3DTrue%5Cn)%5Cnmodel.config.use_cache%20%3D%20False%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22Syvv8%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"uff10220d\" id=\"uff10220d\"><span data-lake-id=\"ufc925fbe\" id=\"ufc925fbe\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">加载预训练模型的分词器，并将其配置为在序列结尾添加填充标记，以便在使用模型进行推断时进行批处理。</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22tokenizer%20%3D%20AutoTokenizer.from_pretrained(model_name%2C%20trust_remote_code%3DTrue)%5Cntokenizer.pad_token%20%3D%20tokenizer.eos_token%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22VBuyb%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"uf5a0970d\" id=\"uf5a0970d\"><span data-lake-id=\"u96736e4e\" id=\"u96736e4e\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">创建一个 PEFT 配置对象，以便在训练和评估模型时使用。</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22from%20peft%20import%20LoraConfig%2C%20get_peft_model%5Cn%20%5Cnlora_alpha%20%3D%2016%5Cnlora_dropout%20%3D%200.1%5Cnlora_r%20%3D%2064%5Cn%20%5Cnpeft_config%20%3D%20LoraConfig(%5Cn%20%20%20%20lora_alpha%3Dlora_alpha%2C%5Cn%20%20%20%20lora_dropout%3Dlora_dropout%2C%5Cn%20%20%20%20r%3Dlora_r%2C%5Cn%20%20%20%20bias%3D%5C%22none%5C%22%2C%5Cn%20%20%20%20task_type%3D%5C%22CAUSAL_LM%5C%22%5Cn)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22TvPia%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h4 data-lake-id=\"67262876\" id=\"67262876\"><span data-lake-id=\"uc58b54dc\" id=\"uc58b54dc\" style=\"color: rgb(51, 51, 51)\">5、加载训练器</span></h4><p data-lake-id=\"u056f670f\" id=\"u056f670f\"><span data-lake-id=\"ub2a34025\" id=\"ub2a34025\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">我们将使用 TRL 库中的 </span><code data-lake-id=\"ue181b486\" id=\"ue181b486\"><span data-lake-id=\"uff8776e7\" id=\"uff8776e7\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">SFTTrainer</span></code><span data-lake-id=\"ud52c9e5c\" id=\"ud52c9e5c\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\"> ，它提供了 transformers </span><code data-lake-id=\"ud6ca83ed\" id=\"ud6ca83ed\"><span data-lake-id=\"u060cf3f6\" id=\"u060cf3f6\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">Trainer</span></code><span data-lake-id=\"ubb71af04\" id=\"ubb71af04\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\"> 的包装器，以便使用 PEFT 适配器轻松地在基于指令的数据集上微调模型。让我们首先加载下面的训练参数。</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22from%20transformers%20import%20TrainingArguments%5Cn%20%5Cnoutput_dir%20%3D%20%5C%22.%2Fresults%5C%22%5Cnper_device_train_batch_size%20%3D%204%5Cngradient_accumulation_steps%20%3D%204%5Cnoptim%20%3D%20%5C%22paged_adamw_32bit%5C%22%5Cnsave_steps%20%3D%20100%5Cnlogging_steps%20%3D%2010%5Cnlearning_rate%20%3D%202e-4%5Cnmax_grad_norm%20%3D%200.3%5Cnmax_steps%20%3D%20100%5Cnwarmup_ratio%20%3D%200.03%5Cnlr_scheduler_type%20%3D%20%5C%22constant%5C%22%5Cn%20%5Cntraining_arguments%20%3D%20TrainingArguments(%5Cn%20%20%20%20output_dir%3Doutput_dir%2C%5Cn%20%20%20%20per_device_train_batch_size%3Dper_device_train_batch_size%2C%5Cn%20%20%20%20gradient_accumulation_steps%3Dgradient_accumulation_steps%2C%5Cn%20%20%20%20optim%3Doptim%2C%5Cn%20%20%20%20save_steps%3Dsave_steps%2C%5Cn%20%20%20%20logging_steps%3Dlogging_steps%2C%5Cn%20%20%20%20learning_rate%3Dlearning_rate%2C%5Cn%20%20%20%20fp16%3DTrue%2C%5Cn%20%20%20%20max_grad_norm%3Dmax_grad_norm%2C%5Cn%20%20%20%20max_steps%3Dmax_steps%2C%5Cn%20%20%20%20warmup_ratio%3Dwarmup_ratio%2C%5Cn%20%20%20%20group_by_length%3DTrue%2C%5Cn%20%20%20%20lr_scheduler_type%3Dlr_scheduler_type%2C%5Cn)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22AS851%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"ue5a58723\" id=\"ue5a58723\"><span data-lake-id=\"u539c68ce\" id=\"u539c68ce\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">然后最后将所有内容传递给训练器，创建一个训练器对象，以便对指定的语言模型进行训练。</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22from%20trl%20import%20SFTTrainer%5Cn%20%5Cnmax_seq_length%20%3D%20512%5Cn%20%5Cntrainer%20%3D%20SFTTrainer(%5Cn%20%20%20%20model%3Dmodel%2C%5Cn%20%20%20%20train_dataset%3Ddataset%2C%5Cn%20%20%20%20peft_config%3Dpeft_config%2C%5Cn%20%20%20%20dataset_text_field%3D%5C%22text%5C%22%2C%5Cn%20%20%20%20max_seq_length%3Dmax_seq_length%2C%5Cn%20%20%20%20tokenizer%3Dtokenizer%2C%5Cn%20%20%20%20args%3Dtraining_arguments%2C%5Cn)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22sYWGW%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u3d3c6885\" id=\"u3d3c6885\"><span data-lake-id=\"udce28075\" id=\"udce28075\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">我们还将通过升级 float 32 中的层规范来预处理模型，以获得更稳定的训练</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22for%20name%2C%20module%20in%20trainer.model.named_modules()%3A%5Cn%20%20%20%20if%20%5C%22norm%5C%22%20in%20name%3A%5Cn%20%20%20%20%20%20%20%20module%20%3D%20module.to(torch.float32)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22JhDyJ%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h4 data-lake-id=\"646b4028\" id=\"646b4028\"><span data-lake-id=\"u116383b8\" id=\"u116383b8\" style=\"color: rgb(51, 51, 51)\">6、训练模型</span></h4><p data-lake-id=\"ubde1b370\" id=\"ubde1b370\"><span data-lake-id=\"ua5dc235f\" id=\"ua5dc235f\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">接下来启动模型的训练过程，以便通过反向传播算法来更新模型参数，从而提高模型的性能。</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22trainer.train()%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22tqWCv%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u1eaf2a98\" id=\"u1eaf2a98\"><span data-lake-id=\"u75bcd32f\" id=\"u75bcd32f\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">在训练过程中，模型应该很好地收敛，如下所示：</span></p><p data-lake-id=\"u277444d5\" id=\"u277444d5\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2025%2Fpng%2F2424104%2F1746780189043-fe78fcb8-ea8d-4088-9f1a-1222ccdbf6fd.png%22%2C%22taskId%22%3A%22u57674da8-2aa9-4f62-888f-99a69b67c37%22%2C%22clientId%22%3A%22ub9dfe58b-6786-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A1448%2C%22height%22%3A832%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A346080%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A2172%2C%22originHeight%22%3A1248%2C%22ratio%22%3A1.5%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22TRAIN%2FGLOBALSTEP%22%2C%22x%22%3A1635%2C%22y%22%3A990%2C%22width%22%3A335%2C%22height%22%3A44%7D%2C%7B%22text%22%3A%22TRAIN%2FLOSS%22%2C%22x%22%3A947%2C%22y%22%3A144%2C%22width%22%3A242%2C%22height%22%3A49%7D%2C%7B%22text%22%3A%221.05%22%2C%22x%22%3A88%2C%22y%22%3A936%2C%22width%22%3A90%2C%22height%22%3A44%7D%2C%7B%22text%22%3A%221.1%22%2C%22x%22%3A103%2C%22y%22%3A760%2C%22width%22%3A77%2C%22height%22%3A45%7D%2C%7B%22text%22%3A%22100%22%2C%22x%22%3A823%2C%22y%22%3A1098%2C%22width%22%3A81%2C%22height%22%3A46%7D%2C%7B%22text%22%3A%22200%22%2C%22x%22%3A1529%2C%22y%22%3A1098%2C%22width%22%3A79%2C%22height%22%3A46%7D%2C%7B%22text%22%3A%22250%22%2C%22x%22%3A1880%2C%22y%22%3A1097%2C%22width%22%3A78%2C%22height%22%3A46%7D%2C%7B%22text%22%3A%22150%22%2C%22x%22%3A1176%2C%22y%22%3A1100%2C%22width%22%3A80%2C%22height%22%3A43%7D%2C%7B%22text%22%3A%221.25%22%2C%22x%22%3A85%2C%22y%22%3A235%2C%22width%22%3A99%2C%22height%22%3A47%7D%2C%7B%22text%22%3A%2250%22%2C%22x%22%3A473%2C%22y%22%3A1097%2C%22width%22%3A65%2C%22height%22%3A47%7D%2C%7B%22text%22%3A%221.15%22%2C%22x%22%3A88%2C%22y%22%3A588%2C%22width%22%3A88%2C%22height%22%3A47%7D%2C%7B%22text%22%3A%221.2%22%2C%22x%22%3A110%2C%22y%22%3A410%2C%22width%22%3A73%2C%22height%22%3A48%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23fdfdfd%22%2C%22id%22%3A%22ucd3d3606%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><p data-lake-id=\"u4d8746ef\" id=\"u4d8746ef\"><span data-lake-id=\"u5ddb82cb\" id=\"u5ddb82cb\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">将训练后的模型保存到本地文件系统中以备后续使用。</span><code data-lake-id=\"u90f16a8e\" id=\"u90f16a8e\"><span data-lake-id=\"u0a48a1b5\" id=\"u0a48a1b5\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">SFTTrainer</span></code><span data-lake-id=\"u70c7bdb9\" id=\"u70c7bdb9\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\"> 仅正确保存适配器，而不是保存整个模型。</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22model_to_save%20%3D%20trainer.model.module%20if%20hasattr(trainer.model%2C%20'module')%20else%20trainer.model%20%20%23%20Take%20care%20of%20distributed%2Fparallel%20training%5Cnmodel_to_save.save_pretrained(%5C%22outputs%5C%22)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22bB8NZ%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u6f9b380f\" id=\"u6f9b380f\"><span data-lake-id=\"ueb848549\" id=\"ueb848549\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">使用 LoraConfig 类加载预训练模型的配置信息，并将其与现有的模型结合起来以获取一个新的模型。</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22lora_config%20%3D%20LoraConfig.from_pretrained('outputs')%5Cnmodel%20%3D%20get_peft_model(model%2C%20lora_config)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22gDuYZ%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u42db119f\" id=\"u42db119f\"><span data-lake-id=\"uac9e9891\" id=\"uac9e9891\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">使用预训练模型生成一段新的文本，以便测试模型的生成能力。</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22text%20%3D%20%5C%22%C3%89crire%20un%20texte%20dans%20un%20style%20baroque%20sur%20la%20glace%20et%20le%20feu%20%23%23%23%20Assistant%3A%20Si%20j'en%20luis%20%C3%A9ton%5C%22%5Cndevice%20%3D%20%5C%22cuda%3A0%5C%22%5Cn%20%5Cninputs%20%3D%20tokenizer(text%2C%20return_tensors%3D%5C%22pt%5C%22).to(device)%5Cnoutputs%20%3D%20model.generate(**inputs%2C%20max_new_tokens%3D50)%5Cnprint(tokenizer.decode(outputs%5B0%5D%2C%20skip_special_tokens%3DTrue))%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22PWF3U%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"uece8cfe8\" id=\"uece8cfe8\"><span data-lake-id=\"u35a23f43\" id=\"u35a23f43\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">将模型推送到 Hugging Face Hub 上，可以与其他人共享和访问。</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22from%20huggingface_hub%20import%20login%5Cnlogin()%5Cn%20%5Cnmodel.push_to_hub(%5C%22llama2-qlora-finetunined-french%5C%22)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22ienpi%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h3 data-lake-id=\"e7d54691\" id=\"e7d54691\"><span data-lake-id=\"u4af34dd7\" id=\"u4af34dd7\" style=\"color: rgb(51, 51, 51)\">QLoRA 的局限性</span></h3><p data-lake-id=\"ua6729ab3\" id=\"ua6729ab3\"><span data-lake-id=\"u58369f37\" id=\"u58369f37\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">QLoRA 是一种基于 LoRA（Logical Reasoning Architecture）的推理模型，它在某些方面存在一些局限性。以下是一些已知的局限性：</span></p><ol list=\"uc9d21165\"><li fid=\"u35f459cf\" data-lake-id=\"u1068a085\" id=\"u1068a085\"><span data-lake-id=\"u75b8ee11\" id=\"u75b8ee11\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">推理速度较慢：使用四位的推理时，QLoRA 的推理速度相对较慢。目前，QLoRA 的四位推理系统尚未与四位矩阵乘法连接，这可能会影响到其性能和速度。</span></li><li fid=\"u35f459cf\" data-lake-id=\"u0475782a\" id=\"u0475782a\"><span data-lake-id=\"u5168525c\" id=\"u5168525c\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">Trainer 恢复训练失败：在使用 Trainer 来恢复 LoRA 的训练运行时，可能会遇到失败的情况。这可能是由于一些内部问题或配置不正确导致的，需要进一步调查和解决。</span></li><li fid=\"u35f459cf\" data-lake-id=\"u7398c425\" id=\"u7398c425\"><strong><span data-lake-id=\"u104c230b\" id=\"u104c230b\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">bnb_4bit_compute_type='fp16'_</span></strong><span data-lake-id=\"u529775c6\" id=\"u529775c6\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">_的不稳定性：目前，使用 bnb_4bit_compute_type='fp16'可能会导致不稳定性。特别是对于 7B LLaMA 任务，只有 80% 的微调运行没有问题。虽然有解决方案，但尚未以比特和字节的形式实现。</span></li><li fid=\"u35f459cf\" data-lake-id=\"u52ad4170\" id=\"u52ad4170\"><span data-lake-id=\"u9000dd77\" id=\"u9000dd77\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">设置 tokenizer.bos_token_id 为 1：为了避免产生困难，建议将 tokenizer.bos_token_id 设置为 1。这可能是为了确保在使用 QLoRA 时，开始标记（BOS）的 ID 被正确设置为 1，以避免潜在的问题。</span></li></ol><h3 data-lake-id=\"fa95d1a6\" id=\"fa95d1a6\"><span data-lake-id=\"u2b95409f\" id=\"u2b95409f\" style=\"color: rgb(51, 51, 51)\">总结</span></h3><p data-lake-id=\"uaca5dcab\" id=\"uaca5dcab\"><span data-lake-id=\"u2d709c0b\" id=\"u2d709c0b\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">QLoRA 是一种基于量化的语言模型微调方法，它可以将预训练的语言模型量化为低精度格式，从而在保持模型性能的同时提高推理速度和减少模型存储空间。</span></p><p data-lake-id=\"u9a4d5477\" id=\"u9a4d5477\"><span data-lake-id=\"uadd23b9d\" id=\"uadd23b9d\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">我们讲了如何使用 QLoRA 方法微调 LLaMA 2 模型，包括加载预训练模型、设置量化配置、使用 SFTTrainer 类创建训练器对象、训练模型等步骤。我们还讨论了如何使用 BitsAndBytesConfig 函数将模型量化为 4 位，并将 torch.float16 计算数据类型用于计算。这些操作可以帮助我们在保持模型性能的同时提高推理速度和减少模型存储空间，从而使得在资源受限的环境下也能够进行语言模型的部署和应用。</span></p><h3 data-lake-id=\"MP5rc\" id=\"MP5rc\"><span data-lake-id=\"u56cb1a2e\" id=\"u56cb1a2e\" style=\"color: rgb(51, 51, 51)\">参考资料</span></h3><p data-lake-id=\"u63c3094e\" id=\"u63c3094e\"><strong><span data-lake-id=\"u7800e4c4\" id=\"u7800e4c4\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">[1]. QLoRA GitHub：</span></strong></p><p data-lake-id=\"u765c7be8\" id=\"u765c7be8\"><a href=\"https://github.com/artidoro/qlora\" target=\"_blank\" data-lake-id=\"ubad5fe0d\" id=\"ubad5fe0d\"><span data-lake-id=\"u647f86fa\" id=\"u647f86fa\" class=\"lake-fontsize-12\" style=\"color: rgb(65, 131, 196)\">https://github.com/artidoro/qlora</span></a></p><p data-lake-id=\"uc5ebb31f\" id=\"uc5ebb31f\"><strong><span data-lake-id=\"ucc0457b3\" id=\"ucc0457b3\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">[2]. QLoRA Pager：</span></strong></p><p data-lake-id=\"ua295e905\" id=\"ua295e905\"><a href=\"https://arxiv.org/abs/2305.14314\" target=\"_blank\" data-lake-id=\"u86f3a26a\" id=\"u86f3a26a\"><span data-lake-id=\"u74db4489\" id=\"u74db4489\" class=\"lake-fontsize-12\" style=\"color: rgb(65, 131, 196)\">https://arxiv.org/abs/2305.14314</span></a></p><p data-lake-id=\"uc240ffd0\" id=\"uc240ffd0\"><strong><span data-lake-id=\"u4a0a2515\" id=\"u4a0a2515\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">[3]. </span></strong><strong><em><span data-lake-id=\"u1e4b15e4\" id=\"u1e4b15e4\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">Bits and Bytes (for 4-bit training):</span></em></strong></p><p data-lake-id=\"u76368990\" id=\"u76368990\"><a href=\"https://github.com/TimDettmers/bitsandbytes\" target=\"_blank\" data-lake-id=\"uf3ccba19\" id=\"uf3ccba19\"><span data-lake-id=\"u85c86605\" id=\"u85c86605\" class=\"lake-fontsize-12\" style=\"color: rgb(65, 131, 196)\">https://github.com/TimDettmers/bitsandbytes</span></a></p><p data-lake-id=\"u5511095c\" id=\"u5511095c\"><strong><span data-lake-id=\"u23a42993\" id=\"u23a42993\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">[4]. Guanaco HF Playground：</span></strong></p><p data-lake-id=\"uea934f24\" id=\"uea934f24\"><a href=\"https://huggingface.co/spaces/uwnlp/guanaco-playground-tgi\" target=\"_blank\" data-lake-id=\"ucf1f790e\" id=\"ucf1f790e\"><span data-lake-id=\"u713ee449\" id=\"u713ee449\" class=\"lake-fontsize-12\" style=\"color: rgb(65, 131, 196)\">https://huggingface.co/spaces/uwnlp/guanaco-playground-tgi</span></a></p><p data-lake-id=\"u812a6d15\" id=\"u812a6d15\"><strong><span data-lake-id=\"uebb34db8\" id=\"uebb34db8\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">[5].</span></strong><strong><span data-lake-id=\"uef9abad1\" id=\"uef9abad1\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">Guanaco Gradio Colab：</span></strong></p><p data-lake-id=\"u60a9f220\" id=\"u60a9f220\"><a href=\"https://colab.research.google.com/drive/17XEqL1JcmVWjHkT-WczdYkJlNINacwG7?usp=sharing\" target=\"_blank\" data-lake-id=\"u4e4d3d8f\" id=\"u4e4d3d8f\"><span data-lake-id=\"u1bdf8f7b\" id=\"u1bdf8f7b\" class=\"lake-fontsize-12\" style=\"color: rgb(65, 131, 196)\">https://colab.research.google.com/drive/17XEqL1JcmVWjHkT-WczdYkJlNINacwG7?usp=sharing</span></a></p><p data-lake-id=\"u9ba82bc7\" id=\"u9ba82bc7\"><strong><span data-lake-id=\"u63edb6f5\" id=\"u63edb6f5\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">[6].</span></strong><strong><span data-lake-id=\"ud6442f92\" id=\"ud6442f92\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">Guanaco vs ChatGPT Colab：</span></strong></p><p data-lake-id=\"u33a3ec92\" id=\"u33a3ec92\"><a href=\"https://colab.research.google.com/drive/1kK6xasHiav9nhiRUJjPMZb4fAED4qRHb?usp=sharing\" target=\"_blank\" data-lake-id=\"uf6fda4b3\" id=\"uf6fda4b3\"><span data-lake-id=\"u3993fe29\" id=\"u3993fe29\" class=\"lake-fontsize-12\" style=\"color: rgb(65, 131, 196)\">https://colab.research.google.com/drive/1kK6xasHiav9nhiRUJjPMZb4fAED4qRHb?usp=sharing</span></a></p><p data-lake-id=\"u47d6b2a8\" id=\"u47d6b2a8\"><strong><span data-lake-id=\"u68befcef\" id=\"u68befcef\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">[7].</span></strong><strong><span data-lake-id=\"u985bdd7b\" id=\"u985bdd7b\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">PEFT GitHub：</span></strong></p><p data-lake-id=\"uf2322e39\" id=\"uf2322e39\"><a href=\"https://github.com/huggingface/peft\" target=\"_blank\" data-lake-id=\"u18530814\" id=\"u18530814\"><span data-lake-id=\"u02ab4bb7\" id=\"u02ab4bb7\" class=\"lake-fontsize-12\" style=\"color: rgb(65, 131, 196)\">https://github.com/huggingface/peft</span></a></p><p data-lake-id=\"u629b90dc\" id=\"u629b90dc\"><strong><span data-lake-id=\"u322ff9be\" id=\"u322ff9be\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">[8].</span></strong><strong><span data-lake-id=\"uc0b6e2f4\" id=\"uc0b6e2f4\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">LoRA Pager：</span></strong></p><p data-lake-id=\"ua3c7b107\" id=\"ua3c7b107\"><a href=\"https://arxiv.org/pdf/2106.09685.pdf\" target=\"_blank\" data-lake-id=\"u4249d8ff\" id=\"u4249d8ff\"><span data-lake-id=\"uef9ec8ed\" id=\"uef9ec8ed\" class=\"lake-fontsize-12\" style=\"color: rgb(65, 131, 196)\">https://arxiv.org/pdf/2106.09685.pdf</span></a></p><p data-lake-id=\"u96d0606b\" id=\"u96d0606b\"><strong><span data-lake-id=\"ua836c24b\" id=\"ua836c24b\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">[9].</span></strong><strong><span data-lake-id=\"u7f1fd2f5\" id=\"u7f1fd2f5\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">P-Tuning Pager：</span></strong></p><p data-lake-id=\"u1e435bf5\" id=\"u1e435bf5\"><a href=\"https://arxiv.org/pdf/2103.10385.pdf\" target=\"_blank\" data-lake-id=\"u006996ac\" id=\"u006996ac\"><span data-lake-id=\"uf73fa925\" id=\"uf73fa925\" class=\"lake-fontsize-12\" style=\"color: rgb(65, 131, 196)\">https://arxiv.org/pdf/2103.10385.pdf</span></a></p><p data-lake-id=\"u809ec1c9\" id=\"u809ec1c9\"><strong><span data-lake-id=\"u3f4cc855\" id=\"u3f4cc855\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">[10].</span></strong><strong><span data-lake-id=\"u0981fd8b\" id=\"u0981fd8b\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">Prompt Tuning</span></strong><strong><span data-lake-id=\"u4d2984df\" id=\"u4d2984df\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">Pager：</span></strong></p><p data-lake-id=\"ubdacc581\" id=\"ubdacc581\"><a href=\"https://arxiv.org/pdf/2104.08691.pdf\" target=\"_blank\" data-lake-id=\"u12afa894\" id=\"u12afa894\"><span data-lake-id=\"ue0b595dd\" id=\"ue0b595dd\" class=\"lake-fontsize-12\" style=\"color: rgb(65, 131, 196)\">https://arxiv.org/pdf/2104.08691.pdf</span></a></p><p data-lake-id=\"u59f919cd\" id=\"u59f919cd\"><strong><span data-lake-id=\"ua819744c\" id=\"ua819744c\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">[11].</span></strong><strong><span data-lake-id=\"u4d295831\" id=\"u4d295831\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">SFTTrainer HF：</span></strong></p><p data-lake-id=\"u25ec3f93\" id=\"u25ec3f93\"><a href=\"https://huggingface.co/docs/trl/main/en/sft_trainer\" target=\"_blank\" data-lake-id=\"u185e45ed\" id=\"u185e45ed\"><span data-lake-id=\"u6b07ff70\" id=\"u6b07ff70\" class=\"lake-fontsize-12\" style=\"color: rgb(65, 131, 196)\">https://huggingface.co/docs/trl/main/en/sft_trainer</span></a></p>", "format": "lake", "word_count": 2543, "description": "示例代码qlora-llama.zip前言QLoRA 是一种高效的微调方法，通过将梯度反向传播到低阶适配器 (LoRA) 中，以显著减少内存使用量。它可以在单个 48GB GPU 上微调 650 亿个参数的模型，并且能够保持完整的 16 位微调任务性能。同时还推出了一个名为 Guanaco 的...", "updated_at": "2025-05-12T01:42:22.000Z", "created_at": "2025-05-12T01:42:19.000Z", "id": 219177975, "status": 1}