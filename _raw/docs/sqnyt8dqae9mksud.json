r%5Cnfrom%20PIL%20import%20Image%5Cnimport%20requests%5Cn%5Cnconfig%20%3D%20PeftConfig.from_pretrained(%5C%22stevhliu%2Fvit-base-patch16-224-in21k-lora%5C%22)%5Cnmodel%20%3D%20AutoModelForImageClassification.from_pretrained(%5Cn%20%20%20%20config.base_model_name_or_path%2C%5Cn%20%20%20%20label2id%3Dlabel2id%2C%5Cn%20%20%20%20id2label%3Did2label%2C%5Cn%20%20%20%20ignore_mismatched_sizes%3DTrue%2C%5Cn)%5Cnmodel%20%3D%20PeftModel.from_pretrained(model%2C%20%5C%22stevhliu%2Fvit-base-patch16-224-in21k-lora%5C%22)%5Cn%5Cnurl%20%3D%20%5C%22https%3A%2F%2Fhugging-face.cn%2Fdatasets%2Fsayakpaul%2Fsample-datasets%2Fresolve%2Fmain%2Fbeignets.jpeg%5C%22%5Cnimage%20%3D%20Image.open(requests.get(url%2C%20stream%3DTrue).raw)%5Cnimage%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22XhbGH%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"ub3f9d578\" id=\"ub3f9d578\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2025%2Fjpeg%2F2424104%2F1745994160271-6bf96f42-d989-4c37-bcb4-8075a7d62342.jpeg%22%2C%22taskId%22%3A%22u6042cc3d-db34-4adf-88a6-61de8815e02%22%2C%22clientId%22%3A%22u58de41f6-c185-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A272.6666564941406%2C%22height%22%3A181%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22a6d771c3d23ec95fe41f2f08ca6d8af7_beignets.jpeg%22%2C%22size%22%3A9772%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A275%2C%22originHeight%22%3A183%2C%22ratio%22%3A1.6500000953674316%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%239eaaa0%22%2C%22id%22%3A%22bEYIN%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><p data-lake-id=\"u45bb64e5\" id=\"u45bb64e5\"><span data-lake-id=\"u08a50ef8\" id=\"u08a50ef8\" class=\"lake-fontsize-12\" style=\"color: rgb(74, 85, 101)\">将图像转换为 RGB 并返回底层 PyTorch 张量。</span></p><p data-lake-id=\"u89308633\" id=\"u89308633\"><span data-lake-id=\"ue6cb842a\" id=\"ue6cb842a\" style=\"color: rgb(74, 85, 101)\">encoding = image_processor(image.convert(&quot;RGB&quot;), return_tensors=&quot;pt&quot;)</span></p><p data-lake-id=\"ub8663dbf\" id=\"ub8663dbf\"><span data-lake-id=\"u0a7e7011\" id=\"u0a7e7011\" class=\"lake-fontsize-12\" style=\"color: rgb(74, 85, 101)\">现在运行模型并返回预测的类别！</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22with%20torch.no_grad()%3A%5Cn%20%20%20%20outputs%20%3D%20model(**encoding)%5Cn%20%20%20%20logits%20%3D%20outputs.logits%5Cn%5Cnpredicted_class_idx%20%3D%20logits.argmax(-1).item()%5Cnprint(%5C%22Predicted%20class%3A%5C%22%2C%20model.config.id2label%5Bpredicted_class_idx%5D)%5Cn%5C%22Predicted%20class%3A%20beignets%5C%22%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22U2Upl%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card>", "format": "lake", "word_count": 1723, "description": "示例代码lora-train.zip前言一种有效训练大型模型的常用方法是插入（通常在注意力模块中）较小的可训练矩阵，这些矩阵是在微调期间要学习的增量权重矩阵的低秩分解。预训练模型的原始权重矩阵被冻结，只有较小的矩阵在训练期间更新。这减少了可训练参数的数量，从而减少了内存使用和训练时间，对于大型...", "updated_at": "2025-05-07T02:22:07.000Z", "created_at": "2025-05-07T01:44:17.000Z", "id": 218477499, "status": 1}