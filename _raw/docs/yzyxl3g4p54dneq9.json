7b81\" start=\"4\"><li fid=\"ua502f57d\" data-lake-id=\"u8892d4cf\" id=\"u8892d4cf\"><strong><span data-lake-id=\"u4f60cf42\" id=\"u4f60cf42\">总结</span></strong><span data-lake-id=\"u710912f9\" id=\"u710912f9\">：</span></li></ol><ul list=\"u5f95ccff\" data-lake-indent=\"1\"><li fid=\"u2855aa54\" data-lake-id=\"ufd60a623\" id=\"ufd60a623\"><span data-lake-id=\"u7d22a901\" id=\"u7d22a901\">总结Transformer编码器-解码器结构的优势和局限性。</span></li><li fid=\"u2855aa54\" data-lake-id=\"ub45c7744\" id=\"ub45c7744\"><span data-lake-id=\"u0db123c6\" id=\"u0db123c6\">展望未来可能的改进方向和应用场景。</span></li></ul><h3 data-lake-id=\"6c12541a\" id=\"6c12541a\"><span data-lake-id=\"ub1e2b88a\" id=\"ub1e2b88a\">二、项目案例</span></h3><p data-lake-id=\"u0c9c891a\" id=\"u0c9c891a\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2025%2Fpng%2F2424104%2F1751684212011-c4958e88-39e9-460b-b6b3-5005b6d437ae.png%22%2C%22taskId%22%3A%22ub4dd6b3a-ccfd-4fbe-a896-c898ecbf192%22%2C%22clientId%22%3A%22ub2d56d14-5a4b-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A496%2C%22height%22%3A289%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A93614%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A930%2C%22originHeight%22%3A541%2C%22ratio%22%3A1.875%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22%E6%9C%BA%E5%99%A8%E7%BF%BB%E8%AF%91%22%2C%22x%22%3A377%2C%22y%22%3A114%2C%22width%22%3A157%2C%22height%22%3A39%7D%2C%7B%22text%22%3A%22%E6%A8%A1%E5%9E%8B%E8%AE%BE%E8%AE%A1%22%2C%22x%22%3A707%2C%22y%22%3A329%2C%22width%22%3A139%2C%22height%22%3A37%7D%2C%7B%22text%22%3A%22%E5%AF%B9%E8%AF%9D%E7%94%9F%E6%88%90%22%2C%22x%22%3A707%2C%22y%22%3A429%2C%22width%22%3A144%2C%22height%22%3A38%7D%2C%7B%22text%22%3A%22%E6%99%BA%E8%83%BD%E5%AE%A2%E6%9C%8D%22%2C%22x%22%3A377%2C%22y%22%3A380%2C%22width%22%3A156%2C%22height%22%3A39%7D%2C%7B%22text%22%3A%22%E9%97%AE%E9%A2%98%E8%A7%A3%E5%86%B3%22%2C%22x%22%3A709%2C%22y%22%3A482%2C%22width%22%3A141%2C%22height%22%3A35%7D%2C%7B%22text%22%3A%22%E6%95%B0%E6%8D%AE%E5%A4%84%E7%90%86%22%2C%22x%22%3A704%2C%22y%22%3A279%2C%22width%22%3A148%2C%22height%22%3A34%7D%2C%7B%22text%22%3A%22%E6%A8%A1%E5%9E%8B%E6%9E%B6%E6%9E%84%22%2C%22x%22%3A708%2C%22y%22%3A64%2C%22width%22%3A145%2C%22height%22%3A34%7D%2C%7B%22text%22%3A%22%E8%AE%AD%E7%BB%83%E7%AD%96%E7%95%A5%22%2C%22x%22%3A709%2C%22y%22%3A116%2C%22width%22%3A140%2C%22height%22%3A34%7D%2C%7B%22text%22%3A%22%E6%95%B0%E6%8D%AE%E5%87%86%E5%A4%87%22%2C%22x%22%3A707%2C%22y%22%3A13%2C%22width%22%3A141%2C%22height%22%3A36%7D%2C%7B%22text%22%3A%22%E9%A1%B9%E7%9B%AE%E6%A1%88%E4%BE%8B%22%2C%22x%22%3A49%2C%22y%22%3A247%2C%22width%22%3A143%2C%22height%22%3A36%7D%2C%7B%22text%22%3A%22%E8%AE%AD%E7%BB%83%E6%96%B9%E6%B3%95%22%2C%22x%22%3A709%2C%22y%22%3A381%2C%22width%22%3A139%2C%22height%22%3A36%7D%2C%7B%22text%22%3A%22%E6%8E%A8%E7%90%86%E4%BC%98%E5%8C%96%22%2C%22x%22%3A710%2C%22y%22%3A166%2C%22width%22%3A139%2C%22height%22%3A34%7D%2C%7B%22text%22%3A%22%E6%A1%83%E6%88%98%E5%BA%94%E5%AF%B9%22%2C%22x%22%3A708%2C%22y%22%3A219%2C%22width%22%3A133%2C%22height%22%3A32%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23f9f8f8%22%2C%22id%22%3A%22u17cae162%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><h4 data-lake-id=\"f45ffd23\" id=\"f45ffd23\"><span data-lake-id=\"u8311553f\" id=\"u8311553f\">案例背景：机器翻译系统</span></h4><p data-lake-id=\"u363fab26\" id=\"u363fab26\"><span data-lake-id=\"ua3159003\" id=\"ua3159003\">在一个机器翻译项目中，我们需要将英文翻译成中文。项目使用了Transformer的编码器-解码器结构，具体实现如下：</span></p><ol list=\"ubfdf42f4\"><li fid=\"u05a6fc06\" data-lake-id=\"u9e888aa3\" id=\"u9e888aa3\"><strong><span data-lake-id=\"uda9ab0b1\" id=\"uda9ab0b1\">数据准备</span></strong><span data-lake-id=\"ue7da2e04\" id=\"ue7da2e04\">：</span></li></ol><ul list=\"u7812fb72\" data-lake-indent=\"1\"><li fid=\"u3c9f7eac\" data-lake-id=\"u72569bfd\" id=\"u72569bfd\"><span data-lake-id=\"u30362ca6\" id=\"u30362ca6\">收集并清洗了大量的英文-中文平行语料。</span></li><li fid=\"u3c9f7eac\" data-lake-id=\"u6fdf3029\" id=\"u6fdf3029\"><span data-lake-id=\"u7ac15d5f\" id=\"u7ac15d5f\">对文本进行分词和编码，生成词嵌入。</span></li></ul><ol list=\"ubfdf42f4\" start=\"2\"><li fid=\"u05a6fc06\" data-lake-id=\"uf121b9a9\" id=\"uf121b9a9\"><strong><span data-lake-id=\"u083c6405\" id=\"u083c6405\">模型架构</span></strong><span data-lake-id=\"u86d263aa\" id=\"u86d263aa\">：</span></li></ol><ul list=\"u53225aaa\" data-lake-indent=\"1\"><li fid=\"uf6a17a32\" data-lake-id=\"u2f5d235b\" id=\"u2f5d235b\"><span data-lake-id=\"u38265a79\" id=\"u38265a79\">编码器：6层，每层包含多头自注意力机制和前馈神经网络。</span></li><li fid=\"uf6a17a32\" data-lake-id=\"u14cf3753\" id=\"u14cf3753\"><span data-lake-id=\"u74496cdb\" id=\"u74496cdb\">解码器：6层，每层包含掩码多头自注意力机制、编码器-解码器注意力机制和前馈神经网络。</span></li><li fid=\"uf6a17a32\" data-lake-id=\"ud1a7bf63\" id=\"ud1a7bf63\"><span data-lake-id=\"u149ef025\" id=\"u149ef025\">使用位置编码来捕捉序列中的顺序信息。</span></li></ul><ol list=\"ubfdf42f4\" start=\"3\"><li fid=\"u05a6fc06\" data-lake-id=\"u5f554566\" id=\"u5f554566\"><strong><span data-lake-id=\"uaa7625df\" id=\"uaa7625df\">训练过程</span></strong><span data-lake-id=\"u50ef2856\" id=\"u50ef2856\">：</span></li></ol><ul list=\"u2fecf7bf\" data-lake-indent=\"1\"><li fid=\"ue1fa5308\" data-lake-id=\"uadd6fd6b\" id=\"uadd6fd6b\"><span data-lake-id=\"u9e16a7d1\" id=\"u9e16a7d1\">使用交叉熵损失函数和Adam优化器。</span></li><li fid=\"ue1fa5308\" data-lake-id=\"ua98dce2f\" id=\"ua98dce2f\"><span data-lake-id=\"u8f8c6209\" id=\"u8f8c6209\">采用学习率预热和衰减策略。</span></li><li fid=\"ue1fa5308\" data-lake-id=\"ub9269f26\" id=\"ub9269f26\"><span data-lake-id=\"u40fcebb3\" id=\"u40fcebb3\">在训练过程中使用了标签平滑技术来防止过拟合。</span></li></ul><ol list=\"ubfdf42f4\" start=\"4\"><li fid=\"u05a6fc06\" data-lake-id=\"ufccfd725\" id=\"ufccfd725\"><strong><span data-lake-id=\"ua347a9f1\" id=\"ua347a9f1\">推理过程</span></strong><span data-lake-id=\"u3765184a\" id=\"u3765184a\">：</span></li></ol><ul list=\"u38757e8b\" data-lake-indent=\"1\"><li fid=\"u39126f35\" data-lake-id=\"u24433e33\" id=\"u24433e33\"><span data-lake-id=\"u0ed89c5e\" id=\"u0ed89c5e\">使用束搜索（beam search）来生成翻译结果。</span></li><li fid=\"u39126f35\" data-lake-id=\"udd2944ee\" id=\"udd2944ee\"><span data-lake-id=\"udd451d92\" id=\"udd451d92\">通过调整束宽和长度惩罚系数来优化生成质量。</span></li></ul><ol list=\"ubfdf42f4\" start=\"5\"><li fid=\"u05a6fc06\" data-lake-id=\"ub25fe188\" id=\"ub25fe188\"><strong><span data-lake-id=\"u4ff84dbe\" id=\"u4ff84dbe\">挑战与解决方案</span></strong><span data-lake-id=\"u848f7aa3\" id=\"u848f7aa3\">：</span></li></ol><ul list=\"u2a476beb\" data-lake-indent=\"1\"><li fid=\"u2b006748\" data-lake-id=\"ud77111aa\" id=\"ud77111aa\"><strong><span data-lake-id=\"ue0741b4e\" id=\"ue0741b4e\">长序列处理</span></strong><span data-lake-id=\"ub7e1e076\" id=\"ub7e1e076\">：通过增加位置编码的维度和调整注意力头数来提升长序列的处理能力。</span></li><li fid=\"u2b006748\" data-lake-id=\"u389f1484\" id=\"u389f1484\"><strong><span data-lake-id=\"u6394b680\" id=\"u6394b680\">低资源语言</span></strong><span data-lake-id=\"u00bd2bdc\" id=\"u00bd2bdc\">：通过迁移学习和数据增强技术来提升低资源语言的翻译质量。</span></li></ul><h4 data-lake-id=\"4b932228\" id=\"4b932228\"><span data-lake-id=\"u9643b922\" id=\"u9643b922\">案例背景：智能客服系统</span></h4><p data-lake-id=\"u266504e7\" id=\"u266504e7\"><span data-lake-id=\"ue82af101\" id=\"ue82af101\">在另一个智能客服项目中，我们使用Transformer的编码器-解码器结构来实现多轮对话管理：</span></p><ol list=\"uf94c4be3\"><li fid=\"u0d356f01\" data-lake-id=\"u703b3eb1\" id=\"u703b3eb1\"><strong><span data-lake-id=\"u880d8cd3\" id=\"u880d8cd3\">数据准备</span></strong><span data-lake-id=\"ua0ac0610\" id=\"ua0ac0610\">：</span></li></ol><ul list=\"u081848c2\" data-lake-indent=\"1\"><li fid=\"u898fb539\" data-lake-id=\"u130c2cbd\" id=\"u130c2cbd\"><span data-lake-id=\"ubbe08612\" id=\"ubbe08612\">收集了大量的客服对话数据，包括用户提问和客服回答。</span></li><li fid=\"u898fb539\" data-lake-id=\"u4bfaecf5\" id=\"u4bfaecf5\"><span data-lake-id=\"u3104f146\" id=\"u3104f146\">对对话数据进行清洗和标注，生成结构化数据。</span></li></ul><ol list=\"uf94c4be3\" start=\"2\"><li fid=\"u0d356f01\" data-lake-id=\"u87bc058b\" id=\"u87bc058b\"><strong><span data-lake-id=\"u74957622\" id=\"u74957622\">模型架构</span></strong><span data-lake-id=\"udef1a3fd\" id=\"udef1a3fd\">：</span></li></ol><ul list=\"u85e9c9ce\" data-lake-indent=\"1\"><li fid=\"u4d387607\" data-lake-id=\"ub9e4b3f8\" id=\"ub9e4b3f8\"><span data-lake-id=\"u3314e77d\" id=\"u3314e77d\">编码器：4层，专注于理解用户输入的语义。</span></li><li fid=\"u4d387607\" data-lake-id=\"u6d84e02a\" id=\"u6d84e02a\"><span data-lake-id=\"ud876eb1b\" id=\"ud876eb1b\">解码器：4层，生成连贯且符合上下文的回答。</span></li><li fid=\"u4d387607\" data-lake-id=\"u5c0328ab\" id=\"u5c0328ab\"><span data-lake-id=\"ud7783452\" id=\"ud7783452\">使用预训练的词嵌入来提升模型的表现。</span></li></ul><ol list=\"uf94c4be3\" start=\"3\"><li fid=\"u0d356f01\" data-lake-id=\"udbc377cc\" id=\"udbc377cc\"><strong><span data-lake-id=\"u3ce34479\" id=\"u3ce34479\">训练过程</span></strong><span data-lake-id=\"uc40ffa8b\" id=\"uc40ffa8b\">：</span></li></ol><ul list=\"u31e55405\" data-lake-indent=\"1\"><li fid=\"uf544a822\" data-lake-id=\"u44fea0f0\" id=\"u44fea0f0\"><span data-lake-id=\"u59ba57f1\" id=\"u59ba57f1\">使用了联合训练策略，同时优化编码器和解码器。</span></li><li fid=\"uf544a822\" data-lake-id=\"u786222c8\" id=\"u786222c8\"><span data-lake-id=\"u17dd4f47\" id=\"u17dd4f47\">通过对抗训练来提升模型的鲁棒性。</span></li></ul><ol list=\"uf94c4be3\" start=\"4\"><li fid=\"u0d356f01\" data-lake-id=\"u5bef74f8\" id=\"u5bef74f8\"><strong><span data-lake-id=\"u2292c618\" id=\"u2292c618\">推理过程</span></strong><span data-lake-id=\"uc8609213\" id=\"uc8609213\">：</span></li></ol><ul list=\"ub7da81bd\" data-lake-indent=\"1\"><li fid=\"u0ff3959e\" data-lake-id=\"u6a901168\" id=\"u6a901168\"><span data-lake-id=\"u65be5b1c\" id=\"u65be5b1c\">在生成回答时，结合了上下文信息和历史对话记录。</span></li><li fid=\"u0ff3959e\" data-lake-id=\"u988b2097\" id=\"u988b2097\"><span data-lake-id=\"u50fe888c\" id=\"u50fe888c\">使用温度参数（temperature）来控制生成结果的多样性。</span></li></ul><ol list=\"uf94c4be3\" start=\"5\"><li fid=\"u0d356f01\" data-lake-id=\"ub1893868\" id=\"ub1893868\"><strong><span data-lake-id=\"u809191bb\" id=\"u809191bb\">挑战与解决方案</span></strong><span data-lake-id=\"uf9865ce4\" id=\"uf9865ce4\">：</span></li></ol><ul list=\"u37e36b4a\" data-lake-indent=\"1\"><li fid=\"ude1e475f\" data-lake-id=\"u86519c46\" id=\"u86519c46\"><strong><span data-lake-id=\"u82e70d16\" id=\"u82e70d16\">上下文依赖</span></strong><span data-lake-id=\"u49139e5e\" id=\"u49139e5e\">：通过引入额外的注意力机制来捕捉长距离依赖。</span></li><li fid=\"ude1e475f\" data-lake-id=\"ue6fd2b8a\" id=\"ue6fd2b8a\"><strong><span data-lake-id=\"u331cc102\" id=\"u331cc102\">多轮对话一致性</span></strong><span data-lake-id=\"uc8f4c14d\" id=\"uc8f4c14d\">：通过引入对话状态跟踪模块来保持对话的一致性。</span></li></ul><h3 data-lake-id=\"c1822661\" id=\"c1822661\"><span data-lake-id=\"ub4d845b3\" id=\"ub4d845b3\">三、示例回答</span></h3><p data-lake-id=\"u6f3282a4\" id=\"u6f3282a4\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2025%2Fpng%2F2424104%2F1751684226918-1a3cdbb9-03c1-4604-a117-5d58c54aab16.png%22%2C%22taskId%22%3A%22u9d3441bf-a8cf-45e0-8f0f-958049b720f%22%2C%22clientId%22%3A%22ub2d56d14-5a4b-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A468.8%2C%22height%22%3A234%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A74800%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A879%2C%22originHeight%22%3A438%2C%22ratio%22%3A1.875%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22%E4%B8%8A%E4%B8%8B%E6%96%87%E8%9E%8D%E5%90%88%22%2C%22x%22%3A678%2C%22y%22%3A278%2C%22width%22%3A172%2C%22height%22%3A37%7D%2C%7B%22text%22%3A%22%E8%BE%93%E5%87%BA%E7%94%9F%E6%88%90%22%2C%22x%22%3A679%2C%22y%22%3A329%2C%22width%22%3A145%2C%22height%22%3A36%7D%2C%7B%22text%22%3A%22%E7%A4%BA%E4%BE%8B%E5%9B%9E%E7%AD%94%22%2C%22x%22%3A20%2C%22y%22%3A196%2C%22width%22%3A146%2C%22height%22%3A38%7D%2C%7B%22text%22%3A%22%E8%A7%A3%E7%A0%81%E6%9C%BA%E5%88%B6%22%2C%22x%22%3A681%2C%22y%22%3A65%2C%22width%22%3A138%2C%22height%22%3A33%7D%2C%7B%22text%22%3A%22%E7%94%9F%E6%88%90%E7%A4%BA%E4%BE%8B%22%2C%22x%22%3A681%2C%22y%22%3A117%2C%22width%22%3A135%2C%22height%22%3A33%7D%2C%7B%22text%22%3A%22%E4%BB%A3%E7%A0%81%E7%A4%BA%E4%BE%8B%22%2C%22x%22%3A679%2C%22y%22%3A379%2C%22width%22%3A134%2C%22height%22%3A35%7D%2C%7B%22text%22%3A%22%E7%BC%96%E7%A0%81%E6%AD%A5%E9%AA%A4%22%2C%22x%22%3A679%2C%22y%22%3A15%2C%22width%22%3A137%2C%22height%22%3A34%7D%2C%7B%22text%22%3A%22%E4%BB%A3%E7%A0%81%E5%AE%9E%E7%8E%B0%22%2C%22x%22%3A678%2C%22y%22%3A168%2C%22width%22%3A146%2C%22height%22%3A34%7D%2C%7B%22text%22%3A%22%E7%BF%BB%E8%AF%91%E6%B5%81%E7%A8%8B%22%2C%22x%22%3A352%2C%22y%22%3A90%2C%22width%22%3A135%2C%22height%22%3A36%7D%2C%7B%22text%22%3A%22%E5%AE%A2%E6%9C%8D%E5%AF%B9%E8%AF%9D%22%2C%22x%22%3A350%2C%22y%22%3A304%2C%22width%22%3A142%2C%22height%22%3A36%7D%2C%7B%22text%22%3A%22%E8%BE%93%E5%85%A5%E5%A4%84%E7%90%86%22%2C%22x%22%3A678%2C%22y%22%3A228%2C%22width%22%3A141%2C%22height%22%3A33%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23f9f8f7%22%2C%22id%22%3A%22uaf5c5ee5%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><h4 data-lake-id=\"f21d65be\" id=\"f21d65be\"><span data-lake-id=\"u2a1db28f\" id=\"u2a1db28f\">示例：机器翻译系统中的编码器-解码器工作流程</span></h4><ol list=\"u76525823\"><li fid=\"ufe891304\" data-lake-id=\"ue052c8d2\" id=\"ue052c8d2\"><strong><span data-lake-id=\"ue2a59ef4\" id=\"ue2a59ef4\">编码器工作流程</span></strong><span data-lake-id=\"ub4390da2\" id=\"ub4390da2\">：</span></li></ol><ul list=\"uda82951b\" data-lake-indent=\"1\"><li fid=\"ud9cbf515\" data-lake-id=\"ua0dd17d2\" id=\"ua0dd17d2\"><span data-lake-id=\"u1de7968b\" id=\"u1de7968b\">输入：“The cat sat on the mat.”</span></li><li fid=\"ud9cbf515\" data-lake-id=\"ubc0b9094\" id=\"ubc0b9094\"><span data-lake-id=\"u9ad812bc\" id=\"u9ad812bc\">编码器将输入序列转换为词嵌入，并加上位置编码。</span></li><li fid=\"ud9cbf515\" data-lake-id=\"ufa177a58\" id=\"ufa177a58\"><span data-lake-id=\"u1ca14360\" id=\"u1ca14360\">通过多头自注意力机制计算每个词与其他词的关系权重。</span></li><li fid=\"ud9cbf515\" data-lake-id=\"u714edde1\" id=\"u714edde1\"><span data-lake-id=\"ufa67b50f\" id=\"ufa67b50f\">前馈神经网络进一步处理注意力输出，生成编码器的最终输出。</span></li></ul><ol list=\"u76525823\" start=\"2\"><li fid=\"ufe891304\" data-lake-id=\"u0addf5a7\" id=\"u0addf5a7\"><strong><span data-lake-id=\"u6ad0e5d9\" id=\"u6ad0e5d9\">解码器工作流程</span></strong><span data-lake-id=\"u73c2acbe\" id=\"u73c2acbe\">：</span></li></ol><ul list=\"u0068c06b\" data-lake-indent=\"1\"><li fid=\"u471b5bd2\" data-lake-id=\"u6d7a9848\" id=\"u6d7a9848\"><span data-lake-id=\"uf6b96894\" id=\"uf6b96894\">初始输入：起始标记</span><code data-lake-id=\"u0f52751f\" id=\"u0f52751f\"><span data-lake-id=\"uf304bc48\" id=\"uf304bc48\">&lt;s&gt;</span></code><span data-lake-id=\"uaea7d3e3\" id=\"uaea7d3e3\">。</span></li><li fid=\"u471b5bd2\" data-lake-id=\"ub217d1e6\" id=\"ub217d1e6\"><span data-lake-id=\"u378fc4c4\" id=\"u378fc4c4\">解码器通过掩码多头自注意力机制处理当前生成的序列。</span></li><li fid=\"u471b5bd2\" data-lake-id=\"u3a220db6\" id=\"u3a220db6\"><span data-lake-id=\"ue0db33d2\" id=\"ue0db33d2\">编码器-解码器注意力机制将编码器的输出与解码器的当前状态结合，生成上下文向量。</span></li><li fid=\"u471b5bd2\" data-lake-id=\"u8e0585b2\" id=\"u8e0585b2\"><span data-lake-id=\"u27b7e921\" id=\"u27b7e921\">前馈神经网络处理上下文向量，生成下一个词的概率分布。</span></li><li fid=\"u471b5bd2\" data-lake-id=\"u0740f6b3\" id=\"u0740f6b3\"><span data-lake-id=\"u3cba0eff\" id=\"u3cba0eff\">通过束搜索选择最可能的词，例如“猫”。</span></li></ul><ol list=\"u76525823\" start=\"3\"><li fid=\"ufe891304\" data-lake-id=\"ue9b6fc29\" id=\"ue9b6fc29\"><strong><span data-lake-id=\"u69e12586\" id=\"u69e12586\">生成过程</span></strong><span data-lake-id=\"ud6f59564\" id=\"ud6f59564\">：</span></li></ol><ul list=\"u20c28635\" data-lake-indent=\"1\"><li fid=\"uc3efeaa4\" data-lake-id=\"u0f0c97f8\" id=\"u0f0c97f8\"><span data-lake-id=\"u7cc291cd\" id=\"u7cc291cd\">输入：“The cat sat on the mat.”</span></li><li fid=\"uc3efeaa4\" data-lake-id=\"u3ff5c2b8\" id=\"u3ff5c2b8\"><span data-lake-id=\"u60166a04\" id=\"u60166a04\">生成步骤： </span></li></ul><ol list=\"u3c31a065\" data-lake-indent=\"2\"><li fid=\"u02144200\" data-lake-id=\"u9048c45d\" id=\"u9048c45d\"><code data-lake-id=\"u9fd2f676\" id=\"u9fd2f676\"><span data-lake-id=\"ud9009fcc\" id=\"ud9009fcc\">&lt;s&gt;</span></code><span data-lake-id=\"u24dbc6e3\" id=\"u24dbc6e3\"> → “猫”</span></li><li fid=\"u02144200\" data-lake-id=\"uc1274fd2\" id=\"uc1274fd2\"><span data-lake-id=\"ua46da3ee\" id=\"ua46da3ee\">“猫” → “坐”</span></li><li fid=\"u02144200\" data-lake-id=\"u5a50b0c2\" id=\"u5a50b0c2\"><span data-lake-id=\"u96282db0\" id=\"u96282db0\">“坐” → “在”</span></li><li fid=\"u02144200\" data-lake-id=\"ufa9fc07b\" id=\"ufa9fc07b\"><span data-lake-id=\"udafda34f\" id=\"udafda34f\">“在” → “垫子”</span></li><li fid=\"u02144200\" data-lake-id=\"u42908050\" id=\"u42908050\"><span data-lake-id=\"u7b07de5b\" id=\"u7b07de5b\">“垫子” → “上”</span></li><li fid=\"u02144200\" data-lake-id=\"u3a5a2b83\" id=\"u3a5a2b83\"><span data-lake-id=\"ua94bf7a9\" id=\"ua94bf7a9\">“上” → </span><code data-lake-id=\"u1048a532\" id=\"u1048a532\"><span data-lake-id=\"u7a4ef750\" id=\"u7a4ef750\">&lt;/s&gt;</span></code></li></ol><ul list=\"u20c28635\" start=\"3\" data-lake-indent=\"1\"><li fid=\"uc3efeaa4\" data-lake-id=\"u9a43b5c7\" id=\"u9a43b5c7\"><span data-lake-id=\"u809fc058\" id=\"u809fc058\">最终输出：“猫坐在垫子上。”</span></li></ul><ol list=\"u76525823\" start=\"4\"><li fid=\"ufe891304\" data-lake-id=\"ua86adf87\" id=\"ua86adf87\"><strong><span data-lake-id=\"u29434033\" id=\"u29434033\">代码片段</span></strong><span data-lake-id=\"u3cf5df7e\" id=\"u3cf5df7e\">：</span></li></ol><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22import%20torch%5Cnfrom%20transformers%20import%20Transformer%2C%20TransformerConfig%5Cn%5Cnconfig%20%3D%20TransformerConfig(%5Cn%20%20%20%20vocab_size%3D30000%2C%5Cn%20%20%20%20max_posit