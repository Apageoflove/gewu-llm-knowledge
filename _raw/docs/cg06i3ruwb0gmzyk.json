{"_kind": "doc", "slug": "cg06i3ruwb0gmzyk", "title": "35.DeepSeek开源Day5：3FS&smallpond技术详解", "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><meta name=\"paragraphSpacing\" content=\"relax\" /><p data-lake-id=\"ufa60c3e3\" id=\"ufa60c3e3\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2025%2Fpng%2F2424104%2F1740728923016-9614ed08-c64a-4fd7-8e9c-17898746027c.png%22%2C%22taskId%22%3A%22udceb1dfc-95f5-4e04-a71c-fdc4c918310%22%2C%22clientId%22%3A%22u5f82a754-e408-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A490.5555360626299%2C%22height%22%3A603%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A209919%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A883%2C%22originHeight%22%3A1086%2C%22ratio%22%3A1.8000000715255737%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22FIRE-FLYER%E6%96%87%E4%BB%B6%E7%B3%BB%E7%BB%9F(3FS).%E4%B8%80%E7%A7%8D%E5%88%A9%E7%94%A8%E7%8E%B0%E4%BB%A3SSD%E5%92%8CRDMA%E7%BD%91%E7%BB%9C%E7%9A%84%E5%85%A8%E9%83%A8%E5%B8%A6%E5%AE%BD%E7%9A%84%22%2C%22x%22%3A26%2C%22y%22%3A810%2C%22width%22%3A796%2C%22height%22%3A27%7D%2C%7B%22text%22%3A%22%E5%9C%A8V3%2FR1%E4%B8%AD%E8%BF%9B%E8%A1%8C%E8%AE%AD%E7%BB%83%E6%95%B0%E6%8D%AE%E9%A2%84%E5%A4%84%E7%90%86%2C%E6%95%B0%E6%8D%AE%E9%9B%86%E5%8A%A0%E8%BD%BD%2C%E6%A3%80%E6%9F%A5%E7%82%B9%E4%BF%9D%E5%AD%98%2F%E9%87%8D%E6%96%B0%E5%8A%A0%E8%BD%BD.%22%2C%22x%22%3A32%2C%22y%22%3A1015%2C%22width%22%3A776%2C%22height%22%3A28%7D%2C%7B%22text%22%3A%22DAY5OF%23OPENSOURCEWEEK%3A3FS%2CTHRUSTERFORALLDEEPSEEKDATA%22%2C%22x%22%3A36%2C%22y%22%3A106%2C%22width%22%3A729%2C%22height%22%3A28%7D%2C%7B%22text%22%3A%22Y%E7%AC%AC5%E5%A4%A9%23OPENSOURCEWEEK%3A3FS%2C%E7%94%A8%E4%BA%8E%E6%89%80%E6%9C%89DEEPSEEK%E6%95%B0%E6%8D%AE%E8%AE%BF%E9%97%AE%E7%9A%84%22%2C%22x%22%3A29%2C%22y%22%3A7