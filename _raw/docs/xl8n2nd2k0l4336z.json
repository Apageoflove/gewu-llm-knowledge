 fid=\"u1d66ed20\" data-lake-id=\"u40197909\" id=\"u40197909\"><strong><span data-lake-id=\"u2693bbae\" id=\"u2693bbae\">总结</span></strong><span data-lake-id=\"u8e2582c4\" id=\"u8e2582c4\">：归纳选择依据及互补性。</span></li></ol><p data-lake-id=\"u97e9676c\" id=\"u97e9676c\"><br></p><h3 data-lake-id=\"6c12541a\" id=\"6c12541a\"><span data-lake-id=\"ue1b6a6bf\" id=\"ue1b6a6bf\">二、项目案例</span></h3><p data-lake-id=\"u5e0d8ec4\" id=\"u5e0d8ec4\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2025%2Fpng%2F2424104%2F1751682650408-0918dfb1-6f3b-47ff-96b5-029d092ab40f.png%22%2C%22taskId%22%3A%22u014b87f7-7f99-4a8e-b841-6e4f836cbbc%22%2C%22clientId%22%3A%22u44ee1336-ea13-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A536.5333333333333%2C%22height%22%3A199%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A59319%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A1006%2C%22originHeight%22%3A373%2C%22ratio%22%3A1.875%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22PREFIX%E5%B1%80%E9%99%90%22%2C%22x%22%3A729%2C%22y%22%3A314%2C%22width%22%3A180%2C%22height%22%3A40%7D%2C%7B%22text%22%3A%22%E9%A1%B9%E6%97%A5%E6%A1%88%E4%BE%8B%22%2C%22x%22%3A44%2C%22y%22%3A163%2C%22width%22%3A156%2C%22height%22%3A41%7D%2C%7B%22text%22%3A%22CAUSA%E5%B1%80%E9%99%90%22%2C%22x%22%3A735%2C%22y%22%3A133%2C%22width%22%3A196%2C%22height%22%3A34%7D%2C%7B%22text%22%3A%22CAUSA%E5%BA%94%E7%94%A8%22%2C%22x%22%3A738%2C%22y%22%3A260%2C%22width%22%3A206%2C%22height%22%3A34%7D%2C%7B%22text%22%3A%22%E9%9C%80%E6%B1%82%E5%88%86%E6%9E%90%22%2C%22x%22%3A735%2C%22y%22%3A13%2C%22width%22%3A155%2C%22height%22%3A41%7D%2C%7B%22text%22%3A%22%E9%9C%80%E6%B1%82%E5%88%86%E6%9E%90%22%2C%22x%22%3A732%2C%22y%22%3A199%2C%22width%22%3A157%2C%22height%22%3A39%7D%2C%7B%22text%22%3A%22PREFIX%E5%BA%94%E7%94%A8%22%2C%22x%22%3A731%2C%22y%22%3A73%2C%22width%22%3A178%2C%22height%22%3A38%7D%2C%7B%22text%22