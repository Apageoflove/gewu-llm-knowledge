%20%23%20%E7%A7%A9r%3D8%20%20%5Cn%20%20%20%20lora_alpha%3D32%2C%20%20%20%20%20%20%20%23%20%E7%BC%A9%E6%94%BE%E7%B3%BB%E6%95%B0%20%20%5Cn%20%20%20%20target_modules%3D%5B%5C%22q_proj%5C%22%2C%20%5C%22v_proj%5C%22%5D%2C%20%20%23%20%E4%BB%85%E8%B0%83%E6%95%B4%E6%B3%A8%E6%84%8F%E5%8A%9B%E5%B1%82%20%20%5Cn%20%20%20%20lora_dropout%3D0.1%20%20%5Cn)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22rnIvc%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u9946172f\" id=\"u9946172f\"><strong><span data-lake-id=\"ua819fc6a\" id=\"ua819fc6a\">参数量计算</span></strong></p><ul list=\"u9faa1d0a\"><li fid=\"u4047a2ac\" data-lake-id=\"u39d5020b\" id=\"u39d5020b\"><span data-lake-id=\"u214eb3d3\" id=\"u214eb3d3\">原模型参数量：70亿</span></li><li fid=\"u4047a2ac\" data-lake-id=\"u43ac1cb8\" id=\"u43ac1cb8\"><span data-lake-id=\"uce331f8d\" id=\"uce331f8d\">LoRA参数量： </span></li></ul><ul list=\"u9faa1d0a\" data-lake-indent=\"1\"><li fid=\"u7044f895\" data-lake-id=\"u33d38bfb\" id=\"u33d38bfb\"><span data-lake-id=\"u1acd7b5c\" id=\"u1acd7b5c\">每层可训练参数 = </span><code data-lake-id=\"uafc3c499\" id=\"uafc3c499\"><span data-lake-id=\"ue437a1d7\" id=\"ue437a1d7\">r × (d_in + d_out)</span></code></li><li fid=\"u7044f895\" data-lake-id=\"u52a359b0\" id=\"u52a359b0\"><span data-lake-id=\"u9b529ec5\" id=\"u9b529ec5\">以</span><code data-lake-id=\"ud9e71a50\" id=\"ud9e71a50\"><span data-lake-id=\"u3a0e5b08\" id=\"u3a0e5b08\">q_proj</span></code><span data-lake-id=\"u2b705da3\" id=\"u2b705da3\">层为例（d_in=4096, d_out=4096）：<br /></span><code data-lake-id=\"udab96dda\" id=\"udab96dda\"><span data-lake-id=\"ue988749b\" id=\"ue988749b\">8 × (4096 + 4096) = 65,536</span></code><