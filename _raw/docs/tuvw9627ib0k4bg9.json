F%E7%94%A8%E6%AD%A3%E5%88%99%E8%A1%A8%E8%BE%BE%E5%BC%8F%E6%8F%90%E5%8F%96%E8%AE%A2%E5%8D%95%E5%8F%B7%20%20%5Cnimport%20re%20%20%5Cnlog_text%20%3D%20%5C%22%E7%94%A8%E6%88%B7%E6%9F%A5%E8%AF%A2%E8%AE%A2%E5%8D%95%E7%8A%B6%E6%80%81%EF%BC%8C%E8%AE%A2%E5%8D%95%E5%8F%B7%EF%BC%9A123456789%5C%22%20%20%5Cnorder_id%20%3D%20re.findall(r'%5C%5Cd%7B9%7D'%2C%20log_text)%5B0%5D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22owL7K%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><ul list=\"uc9e9162f\" start=\"2\"><li fid=\"u7aef3d34\" data-lake-id=\"ufebaedf9\" id=\"ufebaedf9\"><strong><span data-lake-id=\"u9ae16184\" id=\"u9ae16184\">对话分割</span></strong><span data-lake-id=\"ua4bd8f35\" id=\"ua4bd8f35\">：按会话ID切分多轮对话，保留上下文关联。</span></li></ul><p data-lake-id=\"u25f77e26\" id=\"u25f77e26\"><strong><span data-lake-id=\"ude083820\" id=\"ude083820\">（2）用户意图挖掘</span></strong></p><ul list=\"uec298820\"><li fid=\"uce4d5b9f\" data-lake-id=\"u7c39a905\" id=\"u7c39a905\"><strong><span data-lake-id=\"u906e974f\" id=\"u906e974f\">规则+模型混合分类</span></strong><span data-lake-id=\"u35c85815\" id=\"u35c85815\">： </span></li></ul><ul list=\"uec298820\" data-lake-indent=\"1\"><li fid=\"ua97a6d7d\" data-lake-id=\"u9e3f93c3\" id=\"u9e3f93c3\"><strong><span data-lake-id=\"uae4b6441\" id=\"uae4b6441\">规则引擎</span></strong><span data-lake-id=\"u5b427653\" id=\"u5b427653\">：匹配高频关键词（如“退货”→触发售后流程）。</span></li><li fid=\"ua97a6d7d\" data-lake-id=\"ue0d16467\" id=\"ue0d16467\"><strong><span data-lake-id=\"u023bb175\" id=\"u023bb175\">预训练模型微调</span></strong><span data-lake-id=\"ub18fa141\" id=\"ub18fa141\">：使用BERT分类用户意图（如商品咨询、价格对比）。</span></li></ul><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22%23%20%E7%A4%BA%E4%BE%8B%EF%BC%9A%E4%BD%BF%E7%94%A8HuggingFace%20Transformers%E8%BF%9B%E8%A1%8C%E6%84%8F%E5%9B%BE%E5%88%86%E7%B1%BB%20%20%5Cnfrom%20transformers%20import%20BertForSequenceClassification%20%20%5Cnmodel%20%3D%20BertForSequenceClassification.from_pretrained(%5C%22bert-base-chinese%5C%22)%20%20%5Cninputs%20%3D%20tokenizer(%5C%22%E6%89%8B%E6%9C%BA%E7%94%B5%E6%B1%A0%E7%BB%AD%E8%88%AA%E5%A6%82%E4%BD%95%EF%BC%9F%5C%22%2C%20return_tensors%3D%5C%22pt%5C%22)%20%20%5Cnoutputs%20%3D%20model(**inputs)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22cTs2h%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"uad76f323\" id=\"uad76f323\"><strong><span data-lake-id=\"ue8be7d7b\" id=\"ue8be7d7b\">（3）对话上下文建模</span></strong></p><ul list=\"uf988c4e9\"><li fid=\"ufd362c16\" data-lake-id=\"u3342e866\" id=\"u3342e866\"><strong><span data-lake-id=\"u5952218b\" id=\"u5952218b\">RNN/LSTM处理序列依赖</span></strong><span data-lake-id=\"ud2b9fad1\" id=\"ud2b9fad1\">：捕捉多轮对话中的关键信息（如用户之前提到的商品型号）。</span></li><li fid=\"ufd362c16\" data-lake-id=\"uafb47fb3\" id=\"uafb47fb3\"><strong><span data-lake-id=\"uaa06e278\" id=\"uaa06e278\">Graph-based方法</span></strong><span data-lake-id=\"u825bf77f\" id=\"u825bf77f\">：构建用户-问题-回复的知识图谱，支持跨会话知识关联。</span></li></ul><p data-lake-id=\"u02e89516\" id=\"u02e89516\"><strong><span data-lake-id=\"u640faaa9\" id=\"u640faaa9\">（4）情感分析与优先级排序</span></strong></p><ul list=\"u214999c8\"><li fid=\"uac518b75\" data-lake-id=\"ub2057a14\" id=\"ub2057a14\"><strong><span data-lake-id=\"u9d43f9b0\" id=\"u9d43f9b0\">细粒度情感检测</span></strong><span data-lake-id=\"ud