06\" id=\"u056d0006\">节点</span></strong></p></td><td data-lake-id=\"u0df05da6\" id=\"u0df05da6\"><p data-lake-id=\"u3f24c6c4\" id=\"u3f24c6c4\"><strong><span data-lake-id=\"ua1a617a0\" id=\"ua1a617a0\">参数配置</span></strong></p></td></tr><tr data-lake-id=\"u9c65bfde\" id=\"u9c65bfde\"><td data-lake-id=\"u7ddc6018\" id=\"u7ddc6018\"><p data-lake-id=\"u815f6702\" id=\"u815f6702\"><span data-lake-id=\"u2e2c3302\" id=\"u2e2c3302\">开始 </span></p></td><td data-lake-id=\"ua950fc77\" id=\"ua950fc77\"><p data-lake-id=\"ub52d659e\" id=\"ub52d659e\"><span data-lake-id=\"uffb2875c\" id=\"uffb2875c\">开始节点预置了输入参数 </span><span data-lake-id=\"u16b6c5e5\" id=\"u16b6c5e5\">input</span><span data-lake-id=\"uae2a79a2\" id=\"uae2a79a2\">，</span><strong><span data-lake-id=\"u0a14121d\" id=\"u0a14121d\">String</span></strong><span data-lake-id=\"u11412b2f\" id=\"u11412b2f\"> 类型。 </span></p></td></tr><tr data-lake-id=\"u98951ed4\" id=\"u98951ed4\"><td data-lake-id=\"uff2dd21f\" id=\"uff2dd21f\"><p data-lake-id=\"u2cd7cb17\" id=\"u2cd7cb17\"><span data-lake-id=\"udbe92e36\" id=\"udbe92e36\">getToutiaoNews </span></p></td><td data-lake-id=\"ua3d056fe\" id=\"ua3d056fe\"><p data-lake-id=\"uc1ce58c9\" id=\"uc1ce58c9\"><span data-lake-id=\"u0d555a71\" id=\"u0d555a71\">该节点的输入参数固定取值 </span><strong><span data-lake-id=\"u574373b8\" id=\"u574373b8\">q</span></strong><span data-lake-id=\"u2166765a\" id=\"u2166765a\">，仅需要在</span><strong><span data-lake-id=\"u708f886f\" id=\"u708f886f\">参数值</span></strong><span data-lake-id=\"ue6517cab\" id=\"ue6517cab\">区域引用</span><strong><span data-lake-id=\"u79129ba9\" id=\"u79129ba9\">开始</span></strong><span data-lake-id=\"u94531d42\" id=\"u94531d42\">节点的 </span><span data-lake-id=\"uf9749bb0\" id=\"uf9749bb0\">input</span><span data-lake-id=\"u7ef36f28\" id=\"u7ef36f28\"> 参数。 </span></p></td></tr><tr data-lake-id=\"u723d7082\" id=\"u723d7082\"><td data-lake-id=\"ubf3de7da\" id=\"ubf3de7da\"><p data-lake-id=\"uabdfd95b\" id=\"uabdfd95b\"><span data-lake-id=\"u348903bb\" id=\"u348903bb\">结束 </span></p></td><td data-lake-id=\"u301f4e10\" id=\"u301f4e10\"><p data-lake-id=\"u450602e5\" id=\"u450602e5\"><span data-lake-id=\"u8f9b1f75\" id=\"u8f9b1f75\">新增 </span><span data-lake-id=\"u76778ee0\" id=\"u76778ee0\">output</span><span data-lake-id=\"u1eb6ca7f\" id=\"u1eb6ca7f\"> 输入参数，并在</span><strong><span data-lake-id=\"u22661221\" id=\"u22661221\">参数值</span></strong><span data-lake-id=\"u0aff9622\" id=\"u0aff9622\">区域选择引用 </span><strong><span data-lake-id=\"u7e33055d\" id=\"u7e33055d\">getToutiaoNews </span></strong><span data-lake-id=\"u288c460f\" id=\"u288c460f\">节点的 </span><strong><span data-lake-id=\"u1f293253\" id=\"u1f293253\">news</span></strong><span data-lake-id=\"u6de4be33\" id=\"u6de4be33\"> 参数。 </span></p></td></tr></tbody></table><ol list=\"uc0dbaf6e\"><li fid=\"u8ee8f345\" data-lake-id=\"ucf2d0edf\" id=\"ucf2d0edf\"><span data-lake-id=\"uf82a6c6b\" id=\"uf82a6c6b\">配置完成后，单击页面右上角的</span><strong><span data-lake-id=\"u3da073f3\" id=\"u3da073f3\">试运行</span></strong><span data-lake-id=\"u498043c2\" id=\"u498043c2\">，测试工作流。 </span></li></ol><p data-lake-id=\"u8a3f3f57\" id=\"u8a3f3f57\"><span data-lake-id=\"uc2b06314\" id=\"uc2b06314\">例如，输入 </span><span data-lake-id=\"ua7b6eedf\" id=\"ua7b6eedf\">科技</span><span data-lake-id=\"u449d57c8\" id=\"u449d57c8\"> 进行测试，待所有节点都运行成功（节点会展示绿色边框）后，查看指定节点的运行结果。 </span></p><ol list=\"u4469bc8b\"><li fid=\"u4f7b4f66\" data-lake-id=\"ua54f1c49\" id=\"ua54f1c49\"><span data-lake-id=\"u2d0c5dfd\" id=\"u2d0c5dfd\">测试工作流无问题后，单击页面右上角的</span><strong><span data-lake-id=\"u7b7d081b\" id=\"u7b7d081b\">发布</span></strong><span data-lake-id=\"u51caf173\" id=\"u51caf173\">。 </span></li></ol><p data-lake-id=\"ud161313f\" id=\"ud161313f\"><span data-lake-id=\"ua076ad4b\" id=\"ua076ad4b\">成功发布后，在工作流列表中可以查看到该工作流。 </span></p><h2 data-lake-id=\"8181f1bb\" id=\"8181f1bb\"><span data-lake-id=\"u3a290273\" id=\"u3a290273\">步骤二：在智能体添加工作流并测试 </span></h2><ol list=\"uf05023e1\"><li fid=\"u293e837c\" data-lake-id=\"uffced142\" id=\"uffced142\"><span data-lake-id=\"u9cd3e41d\" id=\"u9cd3e41d\">前往当前团队的 Develop 页面，创建或进入指定智能体。 </span></li><li fid=\"u293e837c\" data-lake-id=\"u9800210b\" id=\"u9800210b\"><span data-lake-id=\"ue518c44a\" id=\"ue518c44a\">在智能体编排页面，找到</span><strong><span data-lake-id=\"u5e17f01b\" id=\"u5e17f01b\">技能</span></strong><span data-lake-id=\"ub627782e\" id=\"ub627782e\">区域的</span><strong><span data-lake-id=\"u68c0ad6a\" id=\"u68c0ad6a\">工作流</span></strong><span data-lake-id=\"u7adb69d3\" id=\"u7adb69d3\">，在右侧单击加号图标。 </span></li><li fid=\"u293e837c\" data-lake-id=\"u8b8f8ec6\" id=\"u8b8f8ec6\"><span data-lake-id=\"ub72e8d81\" id=\"ub72e8d81\">在对话框左侧单击</span><strong><span data-lake-id=\"uedd4ff71\" id=\"uedd4ff71\">团队工作流</span></strong><span data-lake-id=\"u6921f2e2\" id=\"u6921f2e2\">，找到自建的 </span><strong><span data-lake-id=\"u42d5900b\" id=\"u42d5900b\">getNews_tasks</span></strong><span data-lake-id=\"u4a31b79c\" id=\"u4a31b79c\"> 工作流，并在右侧单击</span><strong><span data-lake-id=\"u4c54fc17\" id=\"u4c54fc17\">添加</span></strong><span data-lake-id=\"u3c5c0d27\" id=\"u3c5c0d27\">。 </span></li></ol><p data-lake-id=\"uc28f2851\" id=\"uc28f2851\" style=\"text-indent: 2em\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2025%2Fpng%2F2424104%2F1743238147704-448d8d46-9ed9-4664-a4c4-01f2c429f1fc.png%22%2C%22taskId%22%3A%22u3299699e-6a98-49ed-9352-42ccae77bde%22%2C%22clientId%22%3A%22u52c1ca02-22a4-4%22%2C%22originalType%22%3A%22url%22%2C%22linkTarget%22%3A%22_blank%22%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A2254%2C%22originHeight%22%3A1216%2C%22ratio%22%3A2.0250000953674316%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22DOUDOC%7C%E5%88%9B%E5%BB%BA%E4%BA%8E2024-01-29%22%2C%22x%22%3A620%2C%22y%22%3A1157%2C%22width%22%3A386%2C%22height%22%3A30%7D%2C%7B%22text%22%3A%22ETNEWSTASKS%E5%B7%B2%E5%8F%91%E5%B8%83%22%2C%22x%22%3A602%2C%22y%22%3A989%2C%22width%22%3A32