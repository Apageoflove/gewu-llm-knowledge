ISTS%20sakila%3B%5CnCREATE%20SCHEMA%20sakila%3B%5CnUSE%20sakila%3B%5Cn%5Cn%5CnCREATE%20TABLE%20actor(%5Cnactor_id%20SMALLINT%20UNSIGNED%20NOT%20NULL%20AUTO_INCREMENT%2C%5Cnfirst_name%20VARCHAR(45)%20NOT%20NULL%2C%5Cnlast_name%20VARCHAR(45)%20NOT%20NULL%2C%5Cnlast_update%20TIMESTAMP%20NOT%20NULL%20DEFAULT%20CURRENT_TIMESTAMP%20ON%20UPDATE%20CURRENT_TIMESTAMP%2C%5CnPRIMARY%20KEY(actor_id)%2C%5CnKEY%20idx_actor_last_name%20(last_name)%5Cn)ENGINE%3DInnoDB%20DEFAULT%20CHARSET%3Dutf8mb4%3B%5Cn%5Cn%23%20%E5%88%9B%E5%BB%BA%E8%BF%9C%E7%A8%8B%E7%9A%84%E7%94%A8%E6%88%B7%E5%90%8D%E5%92%8C%E5%AF%86%E7%A0%81%E7%94%A8%E4%BA%8E%E8%BF%9E%E6%8E%A5%E6%95%B0%E6%8D%AE%E5%BA%93%5CnCREATE%20USER%20remote%40'%25'IDENTIFIED%20with%20mysql_native_password%20BY%20'remote'%3B%5Cngrant%20all%20privileges%20on%20*.*%20to%20remote%40'%25'%3B%5Cn%23%20%E5%88%9B%E5%BB%BAexporter%E9%9C%80%E8%A6%81%E8%AF%BB%E5%8F%96%E6%95%B0%E6%8D%AE%E5%BA%93%E6%97%A5%E5%BF%97%E4%BF%A1%E6%81%AF%E7%9A%84%E7%99%BB%E9%99%86%E8%B4%A6%E6%88%B7%EF%BC%8C%E5%B9%B6%E6%8E%88%E4%BA%88%E6%9D%83%E9%99%90%5CnCREATE%20USER%20'exporter'%40'%25'%20IDENTIFIED%20BY%20'exporter'%3B%5CnGRANT%20PROCESS%2C%20REPLICATION%20CLIENT%20ON%20*.*%20TO%20'exporter'%40'%25'%3B%5CnGRANT%20SELECT%20ON%20performance_schema.*%20TO%20'exporter'%40'%25'%3B%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22CwQEc%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u7c30e5cd\" id=\"u7c30e5cd\"><br></p><p data-lake-id=\"u36e24989\" id=\"u36e24989\"><span data-lake-id=\"ued5c2111\" id=\"ued5c2111\">docker 启动 MySQL</span></p><card type=\"inline\" name=\"codeblock\" value=\"