 id=\"u739d0013\"><p data-lake-id=\"ud0dca68c\" id=\"ud0dca68c\" style=\"text-align: center\"><span data-lake-id=\"u0219b8dd\" id=\"u0219b8dd\">CREATE</span></p></td><td data-lake-id=\"u3c112457\" id=\"u3c112457\"><p data-lake-id=\"u0205b979\" id=\"u0205b979\" style=\"text-align: center\"><span data-lake-id=\"uc736e312\" id=\"uc736e312\">在服务器新建一个资源</span></p></td></tr><tr data-lake-id=\"u723d836f\" id=\"u723d836f\" style=\"height: 39px\"><td data-lake-id=\"uc6b81898\" id=\"uc6b81898\"><p data-lake-id=\"uc9917534\" id=\"uc9917534\" style=\"text-align: center\"><span data-lake-id=\"u6cfb8969\" id=\"u6cfb8969\">PUT</span></p></td><td data-lake-id=\"u51e403a3\" id=\"u51e403a3\"><p data-lake-id=\"uecd71364\" id=\"uecd71364\" style=\"text-align: center\"><span data-lake-id=\"u51d34b15\" id=\"u51d34b15\">UPDATE</span></p></td><td data-lake-id=\"uf5017bcc\" id=\"uf5017bcc\"><p data-lake-id=\"u689cbdce\" id=\"u689cbdce\" style=\"text-align: center\"><span data-lake-id=\"uc4551dbf\" id=\"uc4551dbf\">在服务器更新资源</span></p></td></tr><tr data-lake-id=\"u972ea127\" id=\"u972ea127\"><td data-lake-id=\"ube08df5f\" id=\"ube08df5f\"><p data-lake-id=\"u6f32610a\" id=\"u6f32610a\" style=\"text-align: center\"><span data-lake-id=\"u757f956f\" id=\"u757f956f\">DELETE</span></p></td><td data-lake-id=\"ub6c5770f\" id=\"ub6c5770f\"><p data-lake-id=\"u9d5c2f82\" id=\"u9d5c2f82\" style=\"text-align: center\"><span data-lake-id=\"u6a278d05\" id=\"u6a278d05\">DELETE</span></p></td><td data-lake-id=\"ufb5f5fc7\" id=\"ufb5f5fc7\"><p data-lake-id=\"u0ce16f97\" id=\"u0ce16f97\" style=\"text-align: center\"><span data-lake-id=\"u897dddf2\" id=\"u897dddf2\">在服务器删除资源</span></p></td></tr></tbody></table><p data-lake-id=\"u6d0af24a\" id=\"u6d0af24a\"><br></p><h2 data-lake-id=\"CXRvB\" id=\"CXRvB\" collapsed=\"true\"><span data-lake-id=\"u261eb31a\" id=\"u261eb31a\">RESTful接口的设计规则与注意事项</span></h2><h3 data-lake-id=\"yjDyV\" id=\"yjDyV\" collapsed=\"true\" data-lake-index-type=\"0\"><span data-lake-id=\"uf765265e\" id=\"uf765265e\">幂等性</span></h3><p data-lake-id=\"u37b46e5e\" id=\"u37b46e5e\"><span data-lake-id=\"ucbb73926\" id=\"ucbb73926\">当多次重复请求时，接口能保证与预期相符的结果</span></p><ul list=\"u871c8791\"><li fid=\"u076a6087\" data-lake-id=\"uf555d647\" id=\"uf555d647\"><strong><span data-lake-id=\"u0eaf6b7a\" id=\"u0eaf6b7a\">无幂等性</span></strong></li></ul><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22java%22%2C%22code%22%3A%22%2F%2F%E6%9F%A5%E8%AF%A2%E5%B7%A5%E8%B5%84%5Cn%20%20Double%20oldSalary%3DemployeeService.getEmployeeSalary(1)%3B%5Cn%2F%2F%E6%9B%B4%E6%96%B0%E5%B7%A5%E8%B5%84%5Cnboolean%20updated%20%3D%20employeeService.updateEmployeeSalary(employeeId%2C%20oldSalary%2BnewSalary)%3B%5Cn%2F%2F%E6%9B%B4%E6%96%B0%E8%AF%AD%E5%8F%A5%5Cn%40Update(%5C%22UPDATE%20Employees%20SET%20salary%20%3D%20%23%7Bsalary%7D%20WHERE%20employee_id%20%3D%20%23%7BemployeeId%7D%5C%22)%5Cnint%20updateSalary(%40Param(%5C%22employeeId%5C%22)%20int%20employeeId%2C%20%40Param(%5C%22salary%5C%22)%20double%20salary)%3B%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22customStyle%22%3A%5B%5D%2C%22fontSize%22%3A14%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22eybmj%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><blockquote data-lake-id=\"u9527321b\" id=\"u9527321b\"><p data-lake-id=\"u287f0e4c\" id=\"u287f0e4c\"><span data-lake-id=\"u27c6abbc\" id=\"u27c6abbc\">注意：在分布式环境下，为了保证消息的高可靠性，客户端往往会采用重试或者消息补偿的形式重复发送同一个请求，那在这种情况下这段代码就会出严重问题，每一个重复请求被发送到服务器都会让该员工工资加500，最终该员工工资会大于要求实际应收工资</span></p></blockquote><ul list=\"u72166c8a\"><li fid=\"ub65e9d95\" data-lake-id=\"ud0f244b7\" id=\"ud0f244b7\"><span data-lake-id=\"u517262fa\" id=\"u517262fa\">幂等性</span></li></ul><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22java%22%2C%22code%22%3A%22%2F%2F%E6%9F%A5%E8%AF%A2%E5%B7%A5%E8%B5%84%5Cn%20%20Double%20oldSalary%3DemployeeService.getEmployeeSalary(1)%3B%5Cn%2F%2F%E6%9B%B4%E6%96%B0%E5%B7%A5%E8%B5%84%5Cnboolean%20updated%20%3D%20employeeService.updateEmployeeSalaryByVervion(employeeId%2C%20oldSalary%2BnewSalary%2Cversion)%3B%5Cn%2F%2F%E6%9B%B4%E6%96%B0%E8%AF%AD%E5%8F%A5%5Cn%40Update(%5C%22UPDATE%20Employees%20SET%20salary%20%3D%20%23%7Bsalary%7D%2Cversion%3D%23%7Bversion%7D%2B1%20WHERE%20employee_id%20%3D%20%23%7BemployeeId%7D%20and%20version%20%3D%20%23%7Bversion%7D%5C%22)%5Cnint%20updateSalaryByVervion(%40Param(%5C%22employeeId%5C%22)%20int%20employeeId%2C%20%40Param(%5C%22salary%5C%22)%20double%20salary%2C%40Param(%5C%22version%5C%22)%20int%20version)%3B%3B%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22customStyle%22%3A%5B%5D%2C%22fontSize%22%3A14%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22z6FIJ%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><blockquote data-lake-id=\"u296205e5\" id=\"u296205e5\"><p data-lake-id=\"ud23e277f\" id=\"ud23e277f\"><span data-lake-id=\"u3032a498\" id=\"u3032a498\">解决方法： 乐观锁设计在工资表额外增加一个version的字段，代表当前数据的版本，任何对该数据修改操作都会让version字段值+1，这个version的数值要求附加在请求中。</span></p><p data-lake-id=\"u04628d56\" id=\"u04628d56\"><span data-lake-id=\"ueec5fa3f\" id=\"ueec5fa3f\">//此时Update方法除了id条件外，还得加Version判断update employee set salary=500,Version=1 where employee_id=1 and Version=0</span></p></blockquote><h3 data-lake-id=\"RGWzJ\" id=\"RGWzJ\" collapsed=\"true\" data-lake-index-type=\"0\"><span data-lake-id=\"udddf5d68\" id=\"udddf5d68\">标准化的响应结果集</span></h3><blockquote data-lake-id=\"uabd9892f\" id=\"uabd9892f\"><p data-lake-id=\"ub3d7ec7b\" id=\"ub3d7ec7b\"><span data-lake-id=\"uc0307e79\" id=\"uc0307e79\">在标准化的响应结构中：要包含code（服务器处理结果）、message（返回的消息内容）两项，此外data属性是可选项，包含从响应返回的额外数据，如查询结果、新增或更新后的数据。在语义层面，也要遵循相同的规则：如 服务器处理成功，code固定等于0，如果遇到异常情况，企业内部要遵循统一的code命名标准</span></p></blockquote><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22java%22%2C%22code%22%3A%22%7B%5Cn%20%20%5C%22code%5C%22%3A%5C%220%5C%22%2C%20%20%20%2F%2F%E6%9C%8D%E5%8A%A1%E5%99%A8%E5%A4%84%E7%90%86%E6%88%90%E5%8A%9F%5Cn%20%20%5C%22message%5C%22%3A%5C%22success%5C%22%2C%20%2F%2F%E6%9C%8D%E5%8A%A1%E5%99%A8%E8%BF%94%E5%9B%9E%E7%9A%84%E6%B6%88%E6%81%AF%5Cn%20%20%5C%22data%5C%22%3A%7B%20%20%20%20%20%20%20%20%20%20%20%20%20%2F%2F%E8%BF%94%E5%9B%9E%E7%9A%84%E4%BF%A1%E6%81%AF%5Cn%20%20%20%20%20%5C%22name%5C%22%3A%5C%22%E5%BC%A0%E4%B8%89%5C%22%2C%5Cn%20%20%20%20%20%5C%22age%5C%22%3A30%5Cn%20%20%20%7D%20%5Cn%7D%5Cn%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22customStyle%22%3A%5B%5D%2C%22fontSize%22%3A14%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22IlROq%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h3 data-lake-id=\"qjunB\" id=\"qjunB\" collapsed=\"true\" data-lake-index-type=\"0\"><span data-lake-id=\"u7e3e39c2\" id=\"u7e3e39c2\">接口设计采用无状态方案</span></h3><ul list=\"uba100288\"><li fid=\"u2735fb7a\" data-lake-id=\"u02fdd33a\" id=\"u02fdd33a\"><strong><span data-lake-id=\"u74d8cb50\" id=\"u74d8cb50\" class=\"lake-fontsize-12\" style=\"color: var(--tw-prose-bold)\">完整性</span></strong><span data-lake-id=\"ua78c8915\" id=\"ua78c8915\" class=\"lake-fontsize-12\" style=\"color: rgb(13, 13, 13)\">：每个请求都应该包含执行操作所需的所有信息，比如用户身份认证信息、参数以及必要的路径信息。服务器不会存储关于客户端之前请求的任何信息。</span></li><li fid=\"u2735fb7a\" data-lake-id=\"ua20bfb2c\" id=\"ua20bfb2c\"><strong><span data-lake-id=\"u681ee9ab\" id=\"u681ee9ab\" class=\"lake-fontsize-12\" style=\"color: var(--tw-prose-bold)\">独立性</span></strong><span data-lake-id=\"ueaa6bb98\" id=\"ueaa6bb98\" class=\"lake-fontsize-12\" style=\"color: rgb(13, 13, 13)\">：服务器不应保留任何客户端的状态信息。这使得每个请求都成为独立的、自包含的操作，这样每个请求就可以由任何服务器处理，提高了系统的可伸缩性和可靠性。</span></li><li fid=\"u2735fb7a\" data-lake-id=\"ub0fa036e\" id=\"ub0fa036e\"><strong><span data-lake-id=\"u1411d8e1\" id=\"u1411d8e1\" class=\"lake-fontsize-12\" style=\"color: var(--tw-prose-bold)\">会话状态的外部化</span></strong><span data-lake-id=\"u72de1d58\" id=\"u72de1d58\" class=\"lake-fontsize-12\" style=\"color: rgb(13, 13, 13)\">：如果需要维护状态（如用户登录会话），状态应该由客户端负责维护，并在每次请求时发送到服务器。通常，这可以通过cookie、认证令牌或其他在请求中发送的安全机制实现。</span></li></ul><h4 data-lake-id=\"BAS95\" id=\"BAS95\" data-lake-index-type=\"0\"><span data-lake-id=\"ucad4ab4e\" id=\"ucad4ab4e\">两种方案：</span></h4><ul list=\"ud53ad388\"><li fid=\"uc55f6db9\" data-lake-id=\"ua3081a94\" id=\"ua3081a94\"><span data-lake-id=\"uafc43f9a\" id=\"uafc43f9a\">客户端存储认证数据：前端使用存储介质存储用户数据，需要加密，通常方法使用JWT加密或其他</span></li></ul><p data-lake-id=\"u47ffc74f\" id=\"u47ffc74f\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2024%2Fpng%2F26817902%2F1713683883957-08a5221d-5cef-47cd-971f-efe623457480.png%22%2C%22taskId%22%3A%22u8b12945e-9335-41ad-ac10-1c17a4d9d4a%22%2C%22clientId%22%3A%22u283d47b3-d7bd-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A790%2C%22height%22%3A385%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A23197%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A790%2C%22originHeight%22%3A385%2C%22ratio%22%3A1%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22TOMCA%22%2C%22x%22%3A611%2C%22y%22%3A184%2C%22width%22%3A83%2C%22height%22%3A15%7D%2C%7B%22text%22%3A%22TOMCAT%22%2C%22x%22%3A618%2C%22y%22%3A55%2C%22width%22%3A74%2C%22height%22%3A15%7D%2C%7B%22text%22%3A%22TOMCAT%22%2C%22x%22%3A610%2C%22y%22%3A321%2C%22width%22%3A82%2C%22height%22%3A16%7D%2C%7B%22text%22%3A%22COOKIEEUSER%3A1%22%2C%22x%22%3A121%2C%22y%22%3A182%2C%22width%22%3A101%2C%22height%22%3A11%7D%2C%7B%22text%22%3A%22NGINX%22%2C%22x%22%3A302%2C%22y%22%3A178%2C%22width%22%3A60%2C%22height%22%3A16%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23f8f8f8%22%2C%22id%22%3A%22u903381d1%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><ul list=\"u1d4ffc3c\"><li fid=\"u244733c5\" data-lake-id=\"u29822fb1\" id=\"u29822fb1\"><span data-lake-id=\"u8750de96\" id=\"u8750de96\">后端统一存储状态数据：在服务器后端，将这些状态数据统一存储，所有节点访问同一个数据源，后台挂载一个Redis集群，对用户数据存储，既可以避免前台传输的数据泄露问题，还可以保证数据的全局存储，有效保证了数据的去状态化，缺点是架构复杂度增加</span></li></ul><p data-lake-id=\"uc58f7f04\" id=\"uc58f7f04\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2024%2Fpng%2F26817902%2F1713683908980-8cd5ea45-41fc-494f-83a6-08007068f48e.png%22%2C%22taskId%22%3A%22ubceba0a4-24d6-483a-8dfa-41bb7a9413f%22%2C%22clientId%22%3A%22u283d47b3-d7bd-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A781%2C%22height%22%3A385%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A63161%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A781%2C%22originHeight%22%3A385%2C%22ratio%22%3A1%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22%E5%8F%B0%22%2C%22x%22%3A3%2C%22y%22%3A141%2C%22width%22%3A99%2C%22height%22%3A117%7D%2C%7B%22text%22%3A%22USER%3A3%22%2C%22x%22%3A696%2C%22y%22%3A303%2C%22width%22%3A58%2C%22height%22%3A14%7D%2C%7B%22text%22%3A%22REDIS%22%2C%22x%22%3A514%2C%22y%22%3A190%2C%22width%22%3A52%2C%22height%22%3A16%7D%2C%7B%22text%22%3A%22SESSION%22%2C%22x%22%3A696%2C%22y%22%3A284%2C%22width%22%3A55%2C%22height%22%3A14%7D%2C%7B%22text%22%3A%22SE